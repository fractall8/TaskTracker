{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format-staged",
      "command": "dotnet",
      "args": [ "format", "style", "--include", "${staged}" ],
      "include": [ "**/*.cs" ]
    },
    {
      "name": "git-add-staged",
      "command": "git",
      "args": [ "add", "${staged}" ],
      "include": [ "**/*.cs" ]
    }
  ]
}