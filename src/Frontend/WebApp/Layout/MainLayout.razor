@inherits LayoutComponentBase
@implements IDisposable
@inject IProfileStore ProfileStore
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="@_myCustomTheme"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppNavBar />
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _myCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#64748B",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            Info = "#0EA5E9",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444"
        }
    };
    
    protected override void OnInitialized() =>
        ProfileStore.StateChanged += OnStoreStateChanged;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            await ProfileStore.EnsureLoadedAsync();
    }

    public void Dispose() => ProfileStore.StateChanged -= OnStoreStateChanged;

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);
}