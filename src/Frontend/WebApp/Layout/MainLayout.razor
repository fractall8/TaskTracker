@inherits LayoutComponentBase
@implements IDisposable
@inject IProfileStore ProfileStore
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppNavBar />
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    protected override void OnInitialized() =>
        ProfileStore.StateChanged += OnStoreStateChanged;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            await ProfileStore.EnsureLoadedAsync();
    }

    public void Dispose() => ProfileStore.StateChanged -= OnStoreStateChanged;

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);
}