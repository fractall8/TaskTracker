<MudDialog Style="border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
    <TitleContent>
        <span style="font-size: 16px; font-weight: 600; color: var(--mud-palette-text-primary);">
            @Title
        </span>
    </TitleContent>
    <DialogContent>
        <p style="margin: 0; font-size: 13.5px; color: var(--mud-palette-text-secondary); line-height: 1.55;">
            @ContentText
        </p>
    </DialogContent>
    <DialogActions>
        <div style="display: flex; gap: 8px; width: 100%; justify-content: flex-end; padding: 0 8px 8px 8px;">
            <button type="button" class="btn" @onclick="Cancel">@CancelText</button>
            <button type="button" class="btn @ConfirmButtonClass" @onclick="Submit">@ConfirmText</button>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string ContentText { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-danger";

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
}