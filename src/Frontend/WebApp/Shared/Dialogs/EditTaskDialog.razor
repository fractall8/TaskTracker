@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2 mb-n1"/>
            Edit Task
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_model.Title"
                          For="@(() => _model.Title)"
                          Label="Task Title"
                          Required="true"
                          RequiredError="Title is required"
                          MaxLength="100"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3"/>

            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description"
                          Lines="5"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="500"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public TaskDto Task { get; set; } = null!;

    private MudForm? _form;
    private TaskFormModel _model = new();

    protected override void OnInitialized()
    {
        _model.Title = Task.Title;
        _model.Description = Task.Description;
    }

    private void Cancel() => MudDialog?.Cancel();

    private void Delete() => MudDialog?.Close(DialogResult.Ok("DELETE"));

    private async Task Submit()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (_form.IsValid)
            {
                var request = new UpdateTaskRequest(
                    Title: _model.Title,
                    Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                    DueDate: Task.DueDate,
                    AssigneeId: Task.AssigneeId,
                    ColumnId: Task.ColumnId
                );

                MudDialog?.Close(DialogResult.Ok(request));
            }
        }
    }

    public class TaskFormModel
    {
        [Required] [MaxLength(100)] public string Title { get; set; } = string.Empty;

        [MaxLength(500)] public string? Description { get; set; }
    }

}