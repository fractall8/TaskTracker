@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests.Tasks

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2 mb-n1"/>
            @(IsEditMode ? "Edit Task" : "New Task")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_model.Title"
                          For="@(() => _model.Title)"
                          Label="Task Title"
                          Required="true"
                          RequiredError="Title is required"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="100"
                          Class="mb-3"/>

            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (Optional)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="@(IsEditMode ? 5 : 3)"
                          MaxLength="500"
                          Class="mb-3"/>

            <MudSelect T="Guid?"
                       @bind-Value="_model.AssigneeId"
                       Label="Assignee (Optional)"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">— Unassigned —</MudSelectItem>
                @foreach (var user in _users)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)user.Id)">@user.Email</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (IsEditMode)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="Delete" Class="mr-auto">Delete</MudButton>
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            @(IsEditMode ? "Save" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public Guid? WorkspaceId { get; set; }
    [Parameter] public TaskDto? Task { get; set; }

    [Inject] private IWorkspaceStore WorkspaceStore { get; set; } = null!;

    private MudForm? _form;
    private TaskFormModel _model = new();
    private List<UserDto> _users = [];
    
    private bool IsEditMode => Task is not null;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            _model.Title = Task!.Title;
            _model.Description = Task.Description;
            _model.AssigneeId = Task.AssigneeId;
        }

        if (WorkspaceId.HasValue)
        {
            try
            {
                _users = await WorkspaceStore.GetWorkspaceUsersAsync(WorkspaceId.Value);
            }
            catch
            {
                _users = [];
            }
        }
    }

    private void Cancel() => MudDialog?.Cancel();
    
    private void Delete() => MudDialog?.Close(DialogResult.Ok("DELETE"));

    private async Task Submit()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();

            if (_form.IsValid)
            {
                if (IsEditMode)
                {
                     var updateRequest = new UpdateTaskRequest(
                        Title: _model.Title,
                        Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                        DueDate: Task!.DueDate,
                        AssigneeId: _model.AssigneeId,
                        ColumnId: Task.ColumnId
                    );
                    MudDialog?.Close(DialogResult.Ok(updateRequest));
                }
                else
                {
                    var createRequest = new CreateTaskRequest(
                        Title: _model.Title,
                        Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                        DueDate: null,
                        AssigneeId: _model.AssigneeId
                    );
                    MudDialog?.Close(DialogResult.Ok(createRequest));
                }
            }
        }
    }

    public class TaskFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(100)]
        public string Title { get; set; } = string.Empty;

        [MaxLength(500)] public string? Description { get; set; }

        public Guid? AssigneeId { get; set; }
    }
}