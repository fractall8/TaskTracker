@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests.Tasks
@using WebApp.Shared.Toast
@inject CustomToastService Toast

<MudDialog Style="border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
    <TitleContent>
        <span style="font-size: 16px; font-weight: 600; color: var(--mud-palette-text-primary);">
            @(IsEditMode ? "Edit task" : "Create task")
        </span>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <label class="form-field">
                <span>Title</span>
                <InputText @bind-Value="_model.Title" class="form-input" placeholder="e.g. Draft landing page copy" />
                <ValidationMessage For="@(() => _model.Title)" class="validation-error" />
            </label>

            <label class="form-field mt-3">
                <span>Description (Optional)</span>
                <InputTextArea @bind-Value="_model.Description" class="form-input" rows="@(IsEditMode ? 5 : 3)" placeholder="Add more detail" />
                <ValidationMessage For="@(() => _model.Description)" class="validation-error" />
            </label>

            <label class="form-field mt-3">
                <span>Assignee (Optional)</span>
                <MudSelect T="Guid?"
                           @bind-Value="_model.AssigneeId"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Placeholder="— Unassigned —"
                           Style="background: var(--mud-palette-surface); border-radius: 8px;">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">— Unassigned —</MudSelectItem>

                    @foreach (var member in BoardMembersStore.Members)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)member.UserId)">
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Style="width: 24px; height: 24px; font-size: 12px;">
                                    @{
                                        var displayName = !string.IsNullOrWhiteSpace(member.DisplayName) ? member.DisplayName : member.Email;
                                        var initial = displayName.FirstOrDefault().ToString().ToUpper();
                                    }
                                    @if (!string.IsNullOrEmpty(member.AvatarUrl)) { <MudImage Src="@member.AvatarUrl"/> }
                                    else { @initial }
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Class="text-truncate">
                                    @if (!string.IsNullOrWhiteSpace(member.DisplayName))
                                    {
                                        @member.DisplayName <span class="ms-1" style="color: var(--mud-palette-text-secondary); font-size: 0.85em;">(@member.Email)</span>
                                    }
                                    else { @member.Email }
                                </MudText>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </label>
            
            <label class="form-field mt-3">
                <span>Due Date (Optional)</span>
                <MudDatePicker @bind-Date="_model.DueDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true"
                               Placeholder="Select due date"
                               Style="background: var(--mud-palette-surface); border-radius: 8px;"/>
            </label>

            <div class="d-flex w-100 justify-space-between align-center mt-6 mb-2">
                <div>
                    @if (IsEditMode)
                    {
                        <button type="button" class="btn ghost" style="color: var(--mud-palette-error);" @onclick="Delete">Delete task</button>
                    }
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn" @onclick="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@BoardMembersStore.IsLoading">
                        @if (BoardMembersStore.IsLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        }
                        else
                        {
                            @(IsEditMode ? "Save changes" : "Create task")
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public TaskDto? Task { get; set; }

    [Inject] private IBoardMembersStore BoardMembersStore { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private TaskFormModel _model = new();

    private bool IsEditMode => Task is not null;

    protected override async Task OnInitializedAsync()
    {
        BoardMembersStore.StateChanged += StateHasChanged;

        if (IsEditMode)
        {
            _model.Title = Task!.Title;
            _model.Description = Task.Description;
            _model.AssigneeId = Task.AssigneeId;
            _model.DueDate = Task.DueDate?.ToLocalTime().DateTime;
        }

        if (!BoardMembersStore.Members.Any())
        {
            try
            {
                await BoardMembersStore.LoadAsync(BoardId);
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to load board members: {ex.Message}");
            }
        }
    }

    public void Dispose()
    {
        BoardMembersStore.StateChanged -= StateHasChanged;
    }

    private void Cancel() => MudDialog?.Cancel();

    private void Delete() => MudDialog?.Close(DialogResult.Ok("DELETE"));

    private void Submit()
    {
        var dueDateOffset = _model.DueDate.HasValue
            ? new DateTimeOffset(_model.DueDate.Value, DateTimeOffset.Now.Offset).ToUniversalTime()
            : (DateTimeOffset?)null;

        if (IsEditMode)
        {
            var updateRequest = new UpdateTaskRequest(
                Title: _model.Title,
                Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                DueDate: dueDateOffset,
                AssigneeId: _model.AssigneeId,
                ColumnId: Task!.ColumnId
            );
            MudDialog?.Close(DialogResult.Ok(updateRequest));
        }
        else
        {
            var createRequest = new CreateTaskRequest(
                Title: _model.Title,
                Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                DueDate: dueDateOffset,
                AssigneeId: _model.AssigneeId
            );
            MudDialog?.Close(DialogResult.Ok(createRequest));
        }
    }

    public class TaskFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(100)]
        public string Title { get; set; } = string.Empty;

        [MaxLength(500)] public string? Description { get; set; }

        public Guid? AssigneeId { get; set; }

        public DateTime? DueDate { get; set; }
    }

}