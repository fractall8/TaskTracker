@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests.Workspaces
@inject ICurrentUserService currentUserService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">
            <MudIcon Icon="@(Workspace is null ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)"
                     Class="mr-2 mb-n1"/>
            @(Workspace is null ? "New Workspace" : "Edit Workspace")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Label="Workspace Name"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="100"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3"/>

            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (Optional)"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="500"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public WorkspaceDto? Workspace { get; set; }

    private MudForm? _form;
    private WorkspaceFormModel _model = new();

    protected override void OnInitialized()
    {
        if (Workspace is not null)
        {
            _model.Name = Workspace.Name;
            _model.Description = Workspace.Description;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task Submit()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();

            if (_form.IsValid)
            {
                if (currentUserService.User == null) 
                {
                    await currentUserService.InitializeAsync();
                }
                MudDialog?.Close(DialogResult.Ok(new CreateWorkspaceRequest(_model.Name, _model.Description)));
            }
        }
    }

    public class WorkspaceFormModel
    {
        [Required] [MaxLength(100)] public string Name { get; set; } = string.Empty;

        [MaxLength(500)] public string? Description { get; set; }
    }
}
