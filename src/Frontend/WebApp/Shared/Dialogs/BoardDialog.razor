@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests.Boards

<MudDialog Style="border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
    <TitleContent>
        <span style="font-size: 16px; font-weight: 600; color: var(--mud-palette-text-primary);">
            @(Board is null ? "Create board" : "Edit board")
        </span>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator/>

            <label class="form-field">
                <span>Name</span>
                <InputText @bind-Value="_model.Name" class="form-input" placeholder="e.g. Q3 Campaign Launch"/>
                <ValidationMessage For="@(() => _model.Name)" class="validation-error"/>
            </label>

            <label class="form-field mt-3">
                <span>Description (Optional)</span>
                <InputTextArea @bind-Value="_model.Description" class="form-input" rows="4"
                               placeholder="What is this board for?"/>
                <ValidationMessage For="@(() => _model.Description)" class="validation-error"/>
            </label>

            <div class="d-flex w-100 justify-end mt-6 mb-2">
                <div class="d-flex gap-2">
                    <button type="button" class="btn" @onclick="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public BoardPreviewDto? Board { get; set; }

    private BoardFormModel _model = new();

    protected override void OnInitialized()
    {
        if (Board is not null)
        {
            _model.Name = Board.Name;
            _model.Description = Board.Description;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private void Submit()
    {
        if (Board is null)
        {
            var createRequest = new CreateBoardRequest(_model.Name, _model.Description);
            MudDialog?.Close(DialogResult.Ok(createRequest));
        }
        else
        {
            var updateRequest = new UpdateBoardRequest(_model.Name, _model.Description);
            MudDialog?.Close(DialogResult.Ok(updateRequest));
        }
    }

    public class BoardFormModel
    {
        [Required] [MaxLength(100)] public string Name { get; set; } = string.Empty;
        [MaxLength(500)] public string? Description { get; set; }
    }

}