@using System.ComponentModel.DataAnnotations
@using Contracts.DTOs
@using Contracts.Requests

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_model.Name" 
                          For="@(() => _model.Name)" 
                          Label="Board Name" 
                          Required="true" 
                          RequiredError="Name is required" 
                          MaxLength="100" 
                          Class="mb-3" />
                          
            <MudTextField @bind-Value="_model.Description" 
                          For="@(() => _model.Description)" 
                          Label="Description (Optional)" 
                          Lines="3" 
                          MaxLength="500" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] 
    public BoardPreviewDto? Board { get; set; } 

    private MudForm? _form;
    private BoardFormModel _model = new();
    
    protected override void OnInitialized()
    {
        if (Board is not null)
        {
            _model.Name = Board.Name;
            _model.Description = Board.Description;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task Submit()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            
            if (_form.IsValid)
            {
                var resultData = new UpdateBoardRequest(_model.Name, _model.Description);
                MudDialog?.Close(DialogResult.Ok(resultData));
            }
        }
    }

    public class BoardFormModel
    {
        [Required]
        [MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [MaxLength(500)]
        public string? Description { get; set; }
    }
}