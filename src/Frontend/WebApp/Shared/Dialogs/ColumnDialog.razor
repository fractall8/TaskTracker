@using System.ComponentModel.DataAnnotations

<MudDialog Style="border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
    <TitleContent>
        <span style="font-size: 16px; font-weight: 600; color: var(--mud-palette-text-primary);">
            @(string.IsNullOrEmpty(InitialName) ? "Create column" : "Edit column")
        </span>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator/>

            <label class="form-field">
                <span>Name</span>
                <InputText @bind-Value="_model.Name" class="form-input" placeholder="e.g. In Progress"/>
                <ValidationMessage For="@(() => _model.Name)" class="validation-error"/>
            </label>

            <div class="d-flex w-100 justify-end mt-6 mb-2">
                <div class="d-flex gap-2">
                    <button type="button" class="btn" @onclick="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string? InitialName { get; set; }

    private ColumnFormModel _model = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(InitialName))
        {
            _model.Name = InitialName;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private void Submit()
    {
        MudDialog?.Close(DialogResult.Ok(_model.Name.Trim()));
    }

    public class ColumnFormModel
    {
        [Required] [MaxLength(50)] public string Name { get; set; } = string.Empty;
    }

}