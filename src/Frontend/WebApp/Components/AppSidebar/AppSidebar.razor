@using WebApp.Shared.Helpers
@implements IDisposable
@inject IProfileStore ProfileStore
@inject IWorkspaceStore WorkspaceStore
@inject NavigationManager Navigation

<MudDrawer Open="@_drawerOpen" Elevation="0" Variant="DrawerVariant.Mini" Width="280px" MiniWidth="76px"
           Style="border-right: 1px solid rgba(100, 110, 120, 0.2); background-color: var(--mud-palette-drawer-background); overflow: visible !important;">

    <div class="sidebar-wrapper @(_drawerOpen ? "" : "mini")">

        <div class="top-row">
            <div class="brand" @onclick="HandleBrandClick">
                <div class="logo-wrapper">
                    <img src="logo.svg" alt="Spaces Logo" class="brand-mark"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"/>
                    <div class="brand-mark fallback-mark" style="display: none;"></div>

                    <MudIcon Icon="@Icons.Material.Filled.Menu" Class="mini-hamburger" Size="Size.Small"/>
                </div>
                <span class="brand-name">TaskTracker</span>
            </div>

            <div class="collapse-btn-wrapper">
                <MudIconButton Icon="@Icons.Material.Outlined.MenuOpen"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               OnClick="ToggleDrawer"/>
            </div>
        </div>

        <NavLink href="/dashboard" class="nav-item" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" Class="nav-icon"/>
            <span class="nav-text">All workspaces</span>
        </NavLink>

        <div class="side-section-head">
            <button class="side-toggle" @onclick="ToggleWorkspaces">
                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                         Style="@($"transform: {(_wsExpanded ? "none" : "rotate(-90deg)")}; transition: transform .15s")"/>
                <span class="ml-1 section-title">Workspaces</span>
            </button>
        </div>

        @if (_wsExpanded)
        {
            <div class="ws-list">
                @if (WorkspaceStore.Workspaces == null || (!WorkspaceStore.Workspaces.Any() && WorkspaceStore.IsLoading))
                {
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="ws-row" style="pointer-events: none; gap: 9px;">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="7px" Height="7px"
                                         Class="flex-shrink-0" Animation="Animation.Wave"/>
                            <MudSkeleton Width="@(RandomWidth(i))" Height="14px" Animation="Animation.Wave"
                                         Class="ws-skeleton-text"/>
                        </div>
                    }
                }
                else
                {
                    @foreach (var ws in WorkspaceStore.Workspaces)
                    {
                        <NavLink href="@($"/workspaces/{ws.Id}")" class="ws-row" ActiveClass="active">
                            <span class="dot"
                                  style="background-color: @AvatarColorHelper.GetDotColorVar(ws.Name);"></span>
                            <span class="ws-name">@ws.Name</span>
                        </NavLink>
                    }
                }
            </div>
        }

        <div class="side-spacer"></div>

        <div class="theme-toggle-container" @onclick="HandleThemeToggle">
            <div class="d-flex align-center theme-content-wrapper">
                <MudIcon Icon="@(IsDarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)"
                         Size="Size.Small"
                         Class="theme-icon"/>
                <span class="theme-text ml-3">Theme</span>
            </div>

            <div class="pill-toggle @(IsDarkMode ? "dark" : "light")">
                <div class="pill-bg-slider"></div>
                <div class="icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Outlined.LightMode" Class="sun-icon"/>
                </div>
                <div class="icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Class="moon-icon"/>
                </div>
            </div>
        </div>

        <AuthorizeView Context="authState">
            <Authorized>
                <div class="profile-container">
                    @if (_isMenuOpen)
                    {
                        <div class="menu-backdrop" @onclick="CloseMenu"></div>

                        <div class="custom-profile-menu">
                            <a href="/profile" class="custom-menu-item" @onclick="CloseMenu">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small"/>
                                <span>Profile</span>
                            </a>
                            <div class="custom-menu-divider"></div>
                            <div class="custom-menu-item text-danger" @onclick="OnSignOut">
                                <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Error"/>
                                <span style="color: var(--mud-palette-error);">Log out</span>
                            </div>
                        </div>
                    }

                    <button class="profile-row-btn w-100" @onclick="ToggleMenu"
                            disabled="@(ProfileStore.Profile == null)">
                        <div class="profile-row">
                            @if (ProfileStore.Profile == null || ProfileStore.IsLoading)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="30px" Height="30px"
                                             Class="flex-shrink-0" Animation="Animation.Wave"/>
                                <div class="profile-meta">
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="32px"
                                                 Class="rounded" Animation="Animation.Wave"/>
                                </div>
                            }
                            else
                            {
                                <div
                                    class="avatar-round flex-shrink-0 @AvatarColorHelper.GetColorClass(ProfileStore.Profile?.DisplayName ?? ProfileStore.Profile?.Email)">
                                    @if (!string.IsNullOrEmpty(ProfileStore.Profile?.AvatarUrl))
                                    {
                                        <img src="@ProfileStore.Profile.AvatarUrl" alt="Avatar"
                                             style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                                    }
                                    else
                                    {
                                        @(ProfileStore.Profile?.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? ProfileStore.Profile?.Email?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                    }
                                </div>

                                <div class="profile-meta">
                                    <p class="profile-name">@ProfileStore.Profile?.DisplayName</p>
                                    <p class="profile-email">@ProfileStore.Profile?.Email</p>
                                </div>

                                <MudIcon Class="profile-chevron"
                                         Icon="@(_isMenuOpen ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)"
                                         Size="Size.Small" Style="color: var(--mud-palette-text-secondary);"/>
                            }
                        </div>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="pa-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="OnSignIn"
                               Class="login-btn-full">
                        Log In
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Primary" Variant="Variant.Filled"
                                   OnClick="OnSignIn" Class="login-btn-mini"/>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</MudDrawer>

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback OnThemeToggled { get; set; }
    [Parameter] public EventCallback OnSignIn { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private bool _drawerOpen = true;
    private bool _wsExpanded = true;
    private bool _isMenuOpen = false;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleWorkspaces() => _wsExpanded = !_wsExpanded;
    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void CloseMenu() => _isMenuOpen = false;

    private void HandleBrandClick()
    {
        if (_drawerOpen) Navigation.NavigateTo("/dashboard");
        else ToggleDrawer();
    }

    private async Task HandleThemeToggle()
    {
        if (OnThemeToggled.HasDelegate)
        {
            await OnThemeToggled.InvokeAsync();
        }
    }

    private string RandomWidth(int index)
    {
        var widths = new[] { "60%", "85%", "40%", "70%", "50%" };
        return widths[index % widths.Length];
    }

    protected override void OnInitialized()
    {
        ProfileStore.StateChanged += OnStoreStateChanged;
        WorkspaceStore.StateChanged += OnStoreStateChanged;
    }

    public void Dispose()
    {
        ProfileStore.StateChanged -= OnStoreStateChanged;
        WorkspaceStore.StateChanged -= OnStoreStateChanged;
    }

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);
}