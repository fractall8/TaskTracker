@* The task detail page's completion control: a pill that turns green and states the state in words. *@
<button type="button"
        class="status-toggle @(Completed ? "completed" : "")"
        aria-pressed="@Completed"
        disabled="@Disabled"
        @onclick="OnClickAsync">
    <span class="status-badge">
        <svg class="status-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
        </svg>
    </span>

    <span class="status-label">@(Completed ? "Completed" : "Mark as complete")</span>
</button>

@code {
    [Parameter] public bool Completed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> CompletedChanged { get; set; }

    private Task OnClickAsync() => Disabled ? Task.CompletedTask : CompletedChanged.InvokeAsync(!Completed);
}
