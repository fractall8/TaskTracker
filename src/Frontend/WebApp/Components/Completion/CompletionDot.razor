@* The card's completion control: a hollow ring that fills and reveals a check.
   Inline SVG rather than MudIcon so the scoped size and scale rules actually reach it. *@
<button type="button"
        class="completion-dot @(Completed ? "completed" : "") @(Small ? "small" : "")"
        aria-label="@(Completed ? "Mark as not completed" : "Mark as completed")"
        aria-pressed="@Completed"
        disabled="@Disabled"
        @onclick="OnClickAsync"
        @onclick:stopPropagation="true">
    <svg class="completion-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
    </svg>
</button>

@code {
    [Parameter] public bool Completed { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> CompletedChanged { get; set; }

    private Task OnClickAsync() => Disabled ? Task.CompletedTask : CompletedChanged.InvokeAsync(!Completed);
}
