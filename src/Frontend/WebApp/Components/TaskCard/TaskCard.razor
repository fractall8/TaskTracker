@using Contracts.DTOs
@using Contracts.Requests.Tasks
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Toast
@inject IBoardDetailsStore Store
@inject IDialogService DialogService
@inject CustomToastService Toast
@inject NavigationManager Navigation
@inject IProfileStore ProfileStore

<div class="task-card @(Task.IsCompleted ? "completed" : "")"
     style="cursor: @(CanMoveTasks ? "grab" : "default");" @onclick="NavigateToTaskDetails">

    <div class="task-card-top">

        <div class="d-flex align-start gap-1" style="min-width: 0;">
            <MudTooltip Text="@(Task.IsCompleted ? "Mark as not completed" : "Mark as completed")"
                        Placement="Placement.Top">
                <MudCheckBox T="bool"
                             Value="Task.IsCompleted"
                             ValueChanged="ToggleCompletionAsync"
                             Disabled="@(!CanCompleteTasks || _isTogglingCompletion)"
                             Dense="true"
                             Size="Size.Small"
                             Color="Color.Success"
                             Class="task-check flex-shrink-0"
                             aria-label="Mark task completed"
                             @onclick:stopPropagation="true"/>
            </MudTooltip>

            @if (Task.AssigneeId.HasValue && Task.AssigneeId == ProfileStore.Profile?.Id)
            {
                <MudTooltip Text="Assigned to you" Placement="Placement.Top">
                    <MudIcon Icon="@Icons.Material.Filled.HowToReg"
                             Color="Color.Primary"
                             Style="font-size: 15px; margin-top: 1px;"
                             Class="flex-shrink-0"/>
                </MudTooltip>
            }
            <p class="task-title">@Task.Title</p>
        </div>

        @if (CanManageTasks)
        {
            <div class="card-actions">
                <button class="icon-btn sm ghost" aria-label="Edit task"
                        @onclick="OpenEditTaskDialog" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                </button>

                <button class="icon-btn sm ghost" aria-label="Delete task"
                        @onclick="ConfirmDeleteTask" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"/>
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Task.Description))
    {
        <p class="task-desc">@Task.Description</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public TaskDto Task { get; set; } = null!;
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public bool CanManageTasks { get; set; }
    [Parameter] public bool CanMoveTasks { get; set; } = true;
    [Parameter] public bool CanCompleteTasks { get; set; }

    private bool _isTogglingCompletion;

    private async Task ToggleCompletionAsync(bool isCompleted)
    {
        if (!CanCompleteTasks || _isTogglingCompletion) return;

        _isTogglingCompletion = true;

        try
        {
            await Store.SetTaskCompletionAsync(Task.Id, isCompleted);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to update task: {ex.Message}");
        }
        finally
        {
            _isTogglingCompletion = false;
        }
    }

    private async Task ConfirmDeleteTask()
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Delete task" },
            { x => x.ContentText, $"Delete \"{Task.Title}\"? This can't be undone." },
            { x => x.ConfirmText, "Delete task" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await Store.DeleteTaskAsync(Task.Id);
                Toast.ShowSuccess("Task deleted.");
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to delete task: {ex.Message}");
            }
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters { ["Task"] = Task, ["Boardid"] = BoardId };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                if (result.Data is UpdateTaskRequest request)
                {
                    await Store.UpdateTaskAsync(Task.Id, request);
                    Toast.ShowSuccess("Task updated");
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private void NavigateToTaskDetails()
    {
        if (Store.BoardId.HasValue)
        {
            Navigation.NavigateTo($"/boards/{Store.BoardId.Value}/tasks/{Task.Id}");
        }
    }

}