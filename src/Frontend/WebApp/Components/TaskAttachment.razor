@using Contracts.DTOs
@using Refit
@using Services.Abstractions.Tasks
@inject ITaskApiService TaskApi
@inject ISnackbar Snackbar

<MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600; color: var(--mud-palette-text-primary);">Attachments
</MudText>

@if (!IsReadOnly)
{
    <div class="d-flex flex-column gap-2 mb-4" style="max-width: 400px;">
        <div class="@(_selectedFile == null ? "" : "d-none")">
            <MudFileUpload T="IBrowserFile" @bind-Files="_selectedFile" Accept=".pdf,.doc,.docx,.png,.jpg,.jpeg">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               Color="Color.Primary">
                        Select File
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>

        @if (_selectedFile != null)
        {
            <MudPaper Elevation="0" Class="pa-3 d-flex align-center justify-space-between rounded-lg"
                      Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-drawer-background);">
                <div class="d-flex align-center gap-2" style="overflow: hidden; flex-grow: 1; padding-right: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Default" Size="Size.Small"/>
                    <MudText Typo="Typo.body2" Class="text-truncate"
                             Style="font-weight: 500; color: var(--mud-palette-text-primary);">
                        @_selectedFile.Name
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); flex-shrink: 0;">
                        (@(Math.Round(_selectedFile.Size / 1024.0, 1)) KB)
                    </MudText>
                </div>

                <div class="d-flex align-center gap-2" style="flex-shrink: 0;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="SubmitUploadAsync" Disabled="_isUploading">
                        @(_isUploading ? "Uploading..." : "Upload")
                    </MudButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                   OnClick="ClearSelectedFile" Disabled="_isUploading"/>
                </div>
            </MudPaper>
        }
    </div>
}

@if (Attachments != null && Attachments.Any())
{
    <MudGrid Spacing="2">
        @foreach (var attachment in Attachments.OrderByDescending(a => a.CreatedAt))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-3 d-flex align-center gap-3 rounded-lg"
                          Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-surface);">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Default" Size="Size.Large"/>
                    <div class="d-flex flex-column flex-grow-1" style="overflow: hidden;">
                        <MudText Typo="Typo.body2" Class="text-truncate"
                                 Style="font-weight: 500; color: var(--mud-palette-text-primary);">
                            @attachment.FileName
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                            @(Math.Round(attachment.SizeInBytes / 1024.0, 1)) KB
                        </MudText>
                    </div>

                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Href="@attachment.FileUrl"
                                   Target="_blank"
                                   download="@attachment.FileName"/>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">No attachments yet.</MudText>
}

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    [Parameter, EditorRequired] public Guid TaskId { get; set; }
    [Parameter] public ICollection<AttachmentDto> Attachments { get; set; } = new List<AttachmentDto>();
    [Parameter] public bool IsReadOnly { get; set; }

    private bool _isUploading;
    private IBrowserFile? _selectedFile;

    private void ClearSelectedFile() => _selectedFile = null;

    private async Task SubmitUploadAsync()
    {
        if (_selectedFile == null) return;

        const long maxAllowedSize = 10 * 1024 * 1024; // 10 MB

        if (_selectedFile.Size > maxAllowedSize)
        {
            Snackbar.Add("File is too large (max 10MB).", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize);
            var streamPart = new StreamPart(stream, _selectedFile.Name, _selectedFile.ContentType);

            var newAttachment = await TaskApi.UploadAttachmentAsync(BoardId, TaskId, streamPart);

            Attachments.Add(newAttachment);
            Snackbar.Add("File uploaded successfully", Severity.Success);
            _selectedFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

}