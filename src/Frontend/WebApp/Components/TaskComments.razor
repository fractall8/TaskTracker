@using Contracts.DTOs
@using Contracts.Requests.Comments
@using Services.Abstractions.Tasks
@inject ITaskApiService TaskApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IProfileStore ProfileStore

<div class="d-flex gap-3 mb-6">
    <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="font-size: 16px;">
        @if (!string.IsNullOrEmpty(ProfileStore.Profile?.AvatarUrl))
        {
            <MudImage Src="@ProfileStore.Profile.AvatarUrl"/>
        }
        else
        {
            @(ProfileStore.Profile?.DisplayName?.FirstOrDefault().ToString()?.ToUpper() ?? ProfileStore.Profile?.Email?.FirstOrDefault().ToString()?.ToUpper() ?? "U")
        }
    </MudAvatar>

    <MudPaper Elevation="0" Class="pa-0 flex-grow-1"
              Style="border: 1px solid var(--mud-palette-lines-default); overflow: hidden; border-radius: 8px; background-color: var(--mud-palette-surface);">
        <MudTextField @bind-Value="_newCommentText"
                      Placeholder="Write a comment..."
                      Lines="3"
                      DisableUnderLine="true"
                      Class="pa-3 mx-0"
                      Immediate="true"/>

        <div class="d-flex justify-end pa-2"
             style="background-color: var(--mud-palette-drawer-background); border-top: 1px solid var(--mud-palette-lines-default);">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="SubmitCommentAsync"
                       Disabled="@(string.IsNullOrWhiteSpace(_newCommentText) || _isSubmittingComment)">
                Comment
            </MudButton>
        </div>
    </MudPaper>
</div>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="mt-2"/>
}
else if (_comments != null)
{
    <div class="d-flex flex-column gap-4">
        @foreach (var comment in _comments.OrderByDescending(c => c.CreatedAt))
        {
            <div class="d-flex gap-3">
                <MudAvatar Color="Color.Secondary" Size="Size.Medium" Style="font-size: 16px;">
                    @if (!string.IsNullOrEmpty(comment.AuthorAvatarUrl))
                    {
                        <MudImage Src="@comment.AuthorAvatarUrl"/>
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                    }
                </MudAvatar>

                <div class="flex-grow-1">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                            @comment.AuthorName
                        </MudText>

                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                            @comment.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                            @if (comment.UpdatedAt.HasValue)
                            {
                                <span>(edited)</span>
                            }
                        </MudText>

                        <MudSpacer/>

                        @if (_editingCommentId != comment.Id && ProfileStore.Profile?.Id == comment.AuthorId)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Style="opacity: 0.5;"
                                           OnClick="@(() => StartEditComment(comment))"/>

                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Style="opacity: 0.5;"
                                           OnClick="@(() => ConfirmDeleteComment(comment))"/>
                        }
                    </div>

                    @if (_editingCommentId == comment.Id)
                    {
                        <div class="mt-2">
                            <MudTextField @bind-Value="_editingCommentText"
                                          Lines="2"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="mb-2"
                                          Immediate="true"
                                          AutoFocus="true"/>

                            <div class="d-flex gap-2">
                                <MudButton Size="Size.Small"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           OnClick="@(() => SubmitEditAsync(comment))"
                                           Disabled="@(_isUpdatingComment || string.IsNullOrWhiteSpace(_editingCommentText))">
                                    Update
                                </MudButton>
                                <MudButton Size="Size.Small"
                                           OnClick="CancelEdit"
                                           Disabled="_isUpdatingComment">
                                    Cancel
                                </MudButton>
                            </div>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2"
                                 Style="color: var(--mud-palette-text-primary); white-space: pre-wrap;">
                            @comment.Text
                        </MudText>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    [Parameter, EditorRequired] public Guid TaskId { get; set; }

    private bool _isLoading = true;
    private List<CommentDto>? _comments;

    private string _newCommentText = string.Empty;
    private bool _isSubmittingComment;

    private Guid? _editingCommentId;
    private string _editingCommentText = string.Empty;
    private bool _isUpdatingComment;

    protected override async Task OnInitializedAsync()
    {
        await ProfileStore.EnsureLoadedAsync();
        await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        try
        {
            _isLoading = true;
            _comments = await TaskApi.GetCommentsAsync(BoardId, TaskId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load comments: {ex.Message}", Severity.Error);
            _comments = new List<CommentDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCommentText)) return;

        try
        {
            _isSubmittingComment = true;
            var request = new CreateCommentRequest(_newCommentText);
            var newComment = await TaskApi.CreateCommentAsync(BoardId, TaskId, request);

            _comments?.Add(newComment);
            _newCommentText = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to post comment: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmittingComment = false;
        }
    }

    private void StartEditComment(CommentDto comment)
    {
        _editingCommentId = comment.Id;
        _editingCommentText = comment.Text;
    }

    private void CancelEdit()
    {
        _editingCommentId = null;
        _editingCommentText = string.Empty;
    }

    private async Task SubmitEditAsync(CommentDto comment)
    {
        if (string.IsNullOrWhiteSpace(_editingCommentText) || _editingCommentText == comment.Text)
        {
            CancelEdit();
            return;
        }

        try
        {
            _isUpdatingComment = true;

            var request = new UpdateCommentRequest(_editingCommentText);
            var updatedComment = await TaskApi.UpdateCommentAsync(BoardId, TaskId, comment.Id, request);

            var index = _comments?.FindIndex(c => c.Id == comment.Id) ?? -1;
            if (index != -1 && _comments != null)
            {
                _comments[index] = updatedComment;
            }

            CancelEdit();
            Snackbar.Add("Comment updated", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update comment: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingComment = false;
        }
    }

    private async Task ConfirmDeleteComment(CommentDto comment)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Comment",
            "Are you sure you want to delete this comment?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await TaskApi.DeleteCommentAsync(BoardId, TaskId, comment.Id);
                _comments?.Remove(comment);
                Snackbar.Add("Comment deleted", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

}