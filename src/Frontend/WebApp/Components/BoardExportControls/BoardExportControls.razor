@using Contracts.Constants
@using Contracts.DTOs
@using Contracts.Enums
@using Services.Abstractions.Subscriptions.Stores
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Toast
@implements IDisposable

@inject IBoardDetailsStore BoardDetailsStore
@inject IBoardApiService BoardApi
@inject IWorkspaceSubscriptionsStore SubscriptionsStore
@inject IDialogService DialogService
@inject CustomToastService Toast
@inject IJSRuntime Js

@if (BoardDetailsStore.Board is { } board)
{
    <div class="d-flex align-center gap-3">
        @if (!board.IsArchived && board.BoardRole == BoardRoleDto.Admin)
        {
            <MudTooltip Text="Upgrade workspace subscription to unlock board archiving and export" Disabled="@HasExportFeature">
                <span class="d-inline-block">
                    <button class="btn btn-warning" type="button" @onclick="ArchiveBoardAsync" disabled="@(!HasExportFeature)">
                        <MudIcon Icon="@(HasExportFeature ? Icons.Material.Filled.Archive : Icons.Material.Filled.Lock)" Size="Size.Small"/>
                        Archive board
                    </button>
                </span>
            </MudTooltip>
        }
        else if (board.IsArchived)
        {
            <span class="badge-warning">Archived</span>

            @if (board.ExportStatus is BoardExportStatusDto.Requested or BoardExportStatusDto.Pending or BoardExportStatusDto.Processing)
            {
                <MudTooltip Text="We are currently generating your ZIP archive...">
                    <button class="btn btn-info" disabled type="button">
                        <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="spin-icon"/>
                        Processing export...
                    </button>
                </MudTooltip>
            }
            else
            {
                @if (board.ExportStatus != BoardExportStatusDto.Failed)
                {
                    <MudTooltip Text="Upgrade workspace subscription to download archives" Disabled="@HasDownloadFeature">
                        <span class="d-inline-block">
                            <button class="btn btn-success" type="button" @onclick="DownloadArchiveAsync" disabled="@(!HasDownloadFeature)">
                                <MudIcon Icon="@(HasDownloadFeature ? Icons.Material.Filled.Download : Icons.Material.Filled.Lock)" Size="Size.Small"/>
                                Download archive
                            </button>
                        </span>
                    </MudTooltip>
                }

                @if (board.ReExportStatus is BoardExportStatusDto.Requested or BoardExportStatusDto.Pending or BoardExportStatusDto.Processing)
                {
                    <button class="btn btn-info" disabled type="button">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"
                                             Style="width: 16px; height: 16px;"/>
                        Updating archive...
                    </button>
                }
                else if (board.ReExportStatus == BoardExportStatusDto.Failed || board.ExportStatus == BoardExportStatusDto.Failed)
                {
                    <MudTooltip Text="@(HasExportFeature ? "Export failed. Click to try again." : "Upgrade workspace subscription to re-export archives")">
                        <span class="d-inline-block">
                            <button class="btn btn-error" type="button" @onclick="ReExportBoardAsync" disabled="@(!HasReExportFeature)">
                                <MudIcon Icon="@(HasReExportFeature ? Icons.Material.Filled.Refresh : Icons.Material.Filled.Lock)" Size="Size.Small"/>
                                @(board.ExportStatus == BoardExportStatusDto.Failed ? "Retry export" : "Retry re-export")
                            </button>
                        </span>
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Upgrade workspace subscription to re-export archives" Disabled="@HasReExportFeature">
                        <span class="d-inline-block">
                            <button class="btn" type="button" @onclick="ReExportBoardAsync" disabled="@(!HasReExportFeature)">
                                <MudIcon Icon="@(HasReExportFeature ? Icons.Material.Filled.Refresh : Icons.Material.Filled.Lock)" Size="Size.Small"/>
                                Re-export
                            </button>
                        </span>
                    </MudTooltip>
                }
            }
        }
    </div>
}

@code {
    private Guid? _loadedWorkspaceId;
    
    private bool HasDownloadFeature => SubscriptionsStore.HasFeature(FeatureConstants.BoardArchiveDownload);
    private bool HasExportFeature => SubscriptionsStore.HasFeature(FeatureConstants.BoardExport);
    private bool HasReExportFeature => SubscriptionsStore.HasFeature(FeatureConstants.BoardReExport);
    
    protected override void OnInitialized()
    {
        BoardDetailsStore.StateChanged += OnStoreStateChanged;
        SubscriptionsStore.StateChanged += OnSubscriptionStateChanged;
    }

    public void Dispose()
    {
        BoardDetailsStore.StateChanged -= OnStoreStateChanged;
        SubscriptionsStore.StateChanged -= OnSubscriptionStateChanged;
    }

    private void OnSubscriptionStateChanged() => InvokeAsync(StateHasChanged);

    private void OnStoreStateChanged()
    {
        if (BoardDetailsStore.Board != null && _loadedWorkspaceId != BoardDetailsStore.Board.WorkspaceId)
        {
            _loadedWorkspaceId = BoardDetailsStore.Board.WorkspaceId;
            _ = SubscriptionsStore.LoadBillingDataAsync(_loadedWorkspaceId.Value);
        }
        
        InvokeAsync(StateHasChanged);
    }

    private async Task ArchiveBoardAsync()
    {
        if (!HasExportFeature) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ArchiveBoardDialog>("Archive Board", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BoardExportOptionsDto exportOptions })
        {
            try
            {
                await BoardApi.ArchiveAndExportBoardAsync(BoardDetailsStore.Board!.Id, exportOptions);
                BoardDetailsStore.SetBoardArchived(exportOptions);
                Toast.ShowSuccess("Board archived and export queued successfully.");
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task ReExportBoardAsync()
    {
        if (!HasReExportFeature) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ExportOptionsDialog>("Update Archive", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BoardExportOptionsDto exportOptions })
        {
            try
            {
                await BoardApi.ReExportBoardAsync(BoardDetailsStore.Board!.Id, exportOptions);
                BoardDetailsStore.SetBoardReExporting(exportOptions);
                Toast.ShowInfo("Re-export started. The archive will be updated in the background.");
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task DownloadArchiveAsync()
    {
        if (!HasDownloadFeature) return;
        
        try
        {
            var downloadInfo = await BoardApi.GetBoardArchiveDownloadUrlAsync(BoardDetailsStore.Board!.Id);
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
            await module.InvokeVoidAsync("downloadFromUrl", downloadInfo.DownloadUrl, downloadInfo.FileName);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}