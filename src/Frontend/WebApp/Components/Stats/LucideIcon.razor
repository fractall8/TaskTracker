@* The mockup's icon set. Stroke-based, so these cannot go through MudIcon, which fills its paths. *@
<svg class="lucide" style="width: @(SizePx)px; height: @(SizePx)px;"
     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @Body
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = null!;
    [Parameter] public int SizePx { get; set; } = 16;

    private MarkupString Body => (MarkupString)(Name switch
    {
        "list-checks" =>
            """<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>""",
        "circle-check" =>
            """<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>""",
        "triangle-alert" =>
            """<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>""",
        "clock" =>
            """<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>""",
        "search" =>
            """<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>""",
        "refresh" =>
            """<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/>""",
        _ => ""
    });
}
