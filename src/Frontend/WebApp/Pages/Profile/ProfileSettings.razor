@page "/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject IProfileStore ProfileStore
@inject CustomToastService Toast
@using WebApp.Shared.Toast
@using WebApp.Shared.Helpers
@using Refit

<PageTitle>Profile Settings - TaskTracker</PageTitle>

<div class="profile-page">
    <h1 class="page-title">Profile Settings</h1>

    @if (ProfileStore.Profile is null)
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        </div>
    }
    else
    {
        <div class="profile-grid">
            <div class="card avatar-card">
                <div class="avatar-big @AvatarColorHelper.GetColorClass(ProfileStore.Profile.DisplayName ?? ProfileStore.Profile.Email)">
                    @if (!string.IsNullOrEmpty(ProfileStore.Profile.AvatarUrl))
                    {
                        <img src="@ProfileStore.Profile.AvatarUrl" alt="User Avatar"
                             style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                    }
                    else
                    {
                        @GetInitials(ProfileStore.Profile.DisplayName ?? ProfileStore.Profile.Email)
                    }
                </div>

                <div class="d-flex align-center justify-center gap-3 mt-2">
                    <MudFileUpload T="IBrowserFile" Accept=".png, .jpg, .jpeg" FilesChanged="UploadAvatar"
                                   MaximumFileCount="1">
                        <CustomContent Context="fileContext">
                            <button type="button" class="link-btn" disabled="@_isUploading"
                                    @onclick="@(() => fileContext.OpenFilePickerAsync())">
                                Change avatar
                            </button>
                        </CustomContent>
                        <SelectedTemplate></SelectedTemplate>
                    </MudFileUpload>

                    @if (!string.IsNullOrEmpty(ProfileStore.Profile.AvatarUrl))
                    {
                        <button type="button" class="icon-btn sm ghost" style="color: var(--mud-palette-error);"
                                disabled="@_isUploading" @onclick="DeleteAvatar" title="Remove Avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small"/>
                        </button>
                    }
                </div>

                @if (_isUploading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3 w-100"/>
                }
            </div>

            <div class="card info-card">
                <p class="info-card-title">Personal Information</p>

                <div class="info-row">
                    <div class="info-row-main">
                        <p class="info-label">Display Name</p>

                        @if (_isEditingName)
                        {
                            <div class="field-edit-row">
                                <input class="form-input"
                                       @bind="_displayName"
                                       @bind:event="oninput"
                                       @onkeydown="HandleKeyDown"
                                       disabled="@_isSaving"
                                       autofocus/>

                                <button class="icon-btn sm" aria-label="Save" @onclick="SaveDisplayNameAsync"
                                        disabled="@_isSaving">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>
                                </button>
                                <button class="icon-btn sm" aria-label="Cancel" @onclick="CancelEditName"
                                        disabled="@_isSaving">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small"/>
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="info-value">@(string.IsNullOrWhiteSpace(ProfileStore.Profile.DisplayName) ? "Not set" : ProfileStore.Profile.DisplayName)</p>
                        }
                    </div>

                    @if (!_isEditingName)
                    {
                        <button class="icon-btn sm ghost" aria-label="Edit display name" @onclick="EnableEditing">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                        </button>
                    }
                </div>

                <div class="info-row">
                    <div class="info-row-main">
                        <p class="info-label">Email Address</p>
                        <p class="info-value">@ProfileStore.Profile.Email</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string? _displayName;
    private bool _isUploading;
    private bool _isSaving;
    private bool _isEditingName;

    protected override async Task OnInitializedAsync()
    {
        ProfileStore.StateChanged += StateHasChanged;
        await ProfileStore.EnsureLoadedAsync();

        _displayName = ProfileStore.Profile?.DisplayName;
    }

    public void Dispose() => ProfileStore.StateChanged -= StateHasChanged;

    private void EnableEditing()
    {
        _displayName = ProfileStore.Profile?.DisplayName;
        _isEditingName = true;
    }

    private void CancelEditName()
    {
        _isEditingName = false;
        _displayName = ProfileStore.Profile?.DisplayName;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveDisplayNameAsync();
        }
        else if (e.Key == "Escape")
        {
            CancelEditName();
        }
    }

    private async Task SaveDisplayNameAsync()
    {
        if (_isSaving) return;

        if (string.IsNullOrWhiteSpace(_displayName) || _displayName == ProfileStore.Profile?.DisplayName)
        {
            _displayName = ProfileStore.Profile?.DisplayName;
            _isEditingName = false;
            return;
        }

        _isSaving = true;
        try
        {
            await ProfileStore.UpdateDisplayNameAsync(_displayName);
            Toast.ShowSuccess("Profile updated successfully.");
            _isEditingName = false;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to update profile: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task UploadAvatar(IBrowserFile? file)
    {
        if (file is null) return;

        var maxFileSize = 2 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            var actualSizeMb = file.Size / (1024.0 * 1024.0);
            var maxSizeMb = maxFileSize / (1024 * 1024);

            Toast.ShowError($"Failed to upload avatar: Supplied file with size {actualSizeMb:F2} MB exceeds the maximum of {maxSizeMb} MB.");
            return;
        }

        _isUploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            var streamPart = new StreamPart(stream, file.Name, file.ContentType);

            await ProfileStore.UploadAvatarAsync(streamPart);
            Toast.ShowSuccess("Avatar uploaded successfully.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to upload avatar: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task DeleteAvatar()
    {
        _isUploading = true;
        try
        {
            await ProfileStore.DeleteAvatarAsync();
            Toast.ShowSuccess("Avatar removed.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to remove avatar: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[1][..1]).ToUpper();
    }

}