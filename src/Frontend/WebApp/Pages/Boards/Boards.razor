@page "/boards"
@using Contracts.DTOs
@using Contracts.Requests
@using WebApp.Shared.Dialogs
@implements IDisposable
@inject IBoardStore BoardStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .mud-card-header-content {
        min-width: 0;
    }

    .text-truncate-single {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .text-truncate-multi {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-all;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-8 px-4">
    <div class="d-flex flex-column flex-md-row justify-space-between align-center mb-6 gap-4">
        <MudText Typo="Typo.h4" Class="fw-bold" Style="color: var(--mud-palette-text-primary);">My Boards</MudText>

        <div class="d-flex flex-wrap align-center gap-4">
            <MudTextField T="string"
                          Value="@BoardStore.SearchTerm"
                          ValueChanged="OnSearchTermChangedAsync"
                          Placeholder="Search boards..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Dense="true"
                          Clearable="true"
                          DebounceInterval="500"
                          Style="width: 250px; background-color: var(--mud-palette-surface);"/>

            @if (BoardStore.Pagination.TotalCount > 0 || !string.IsNullOrEmpty(BoardStore.SearchTerm))
            {
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Items per page:</MudText>
                    <MudSelect T="int" Value="@BoardStore.PageSize" ValueChanged="OnPageSizeChangedAsync"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Style="width: 80px; background-color: var(--mud-palette-surface);">
                        <MudSelectItem Value="12">12</MudSelectItem>
                        <MudSelectItem Value="24">24</MudSelectItem>
                        <MudSelectItem Value="48">48</MudSelectItem>
                    </MudSelect>
                </div>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Create Board
            </MudButton>
        </div>
    </div>

    @if (BoardStore.IsLoading && !BoardStore.IsLoaded)
    {
        <div class="d-flex justify-center mt-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (!string.IsNullOrEmpty(BoardStore.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4 rounded-lg">
            @BoardStore.ErrorMessage
        </MudAlert>
    }
    else if (!BoardStore.Boards.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mt-4 rounded-lg">
            @(BoardStore.CurrentPage > 1
                ? "This page is empty. Please return to the previous pages."
                : "You don't have any boards yet. Create your first one!")
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var board in BoardStore.Boards)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2" Class="h-100 d-flex flex-column rounded-lg transition-transform"
                             Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-surface);">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="fw-bold text-truncate-single" Title="@board.Name"
                                         Style="color: var(--mud-palette-text-primary);">
                                    @board.Name
                                </MudText>
                                <MudText Typo="Typo.caption"
                                         Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase;">
                                    Role: @board.Role.ToString()
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent Class="flex-grow-1 overflow-hidden pt-0">
                            <MudText Typo="Typo.body2" Class="text-truncate-multi" Title="@board.Description"
                                     Style="color: var(--mud-palette-text-secondary);">
                                @(string.IsNullOrWhiteSpace(board.Description) ? "No description provided." : board.Description)
                            </MudText>
                        </MudCardContent>

                        <MudCardActions Class="justify-end px-4 pb-4">
                            <MudTooltip Text="Edit Board">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default"
                                               Size="Size.Small" OnClick="@(() => OpenEditDialog(board))"/>
                            </MudTooltip>
                            <MudTooltip Text="Delete Board">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small" OnClick="@(() => DeleteBoard(board))"/>
                            </MudTooltip>

                            <MudButton Href="@($"/boards/{board.Id}")" Variant="Variant.Text" Color="Color.Primary"
                                       Class="ml-2 fw-bold">
                                Open
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (BoardStore.Pagination.TotalPages > 1)
    {
        <div class="d-flex justify-center mt-8">
            <MudPagination Color="Color.Primary"
                           Count="@BoardStore.Pagination.TotalPages"
                           Selected="@BoardStore.CurrentPage"
                           SelectedChanged="OnPageChangedAsync"/>
        </div>
    }
</MudContainer>

@code {
    [Inject] private IBoardApiService BoardApiService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        BoardStore.StateChanged += StateHasChanged;

        if (!BoardStore.IsLoaded)
        {
            await BoardStore.LoadAsync(1);
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        await BoardStore.LoadAsync(page);
    }

    public void Dispose()
    {
        BoardStore.StateChanged -= StateHasChanged;
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BoardDialog>("Create Board", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is UpdateBoardRequest request)
        {
            try
            {
                await BoardApiService.CreateBoardAsync(request);
                Snackbar.Add("Board created successfully.", Severity.Success);

                await BoardStore.RefreshAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to create board: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(BoardPreviewDto board)
    {
        var parameters = new DialogParameters<BoardDialog> { { x => x.Board, board } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BoardDialog>("Edit Board", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is UpdateBoardRequest request)
        {
            try
            {
                await BoardApiService.UpdateBoardAsync(board.Id, request);
                Snackbar.Add("Board updated successfully.", Severity.Success);

                await BoardStore.RefreshAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update board: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteBoard(BoardPreviewDto board)
    {
        var safeBoardName = board.Name.Length > 40 ? board.Name[..40] + "..." : board.Name;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Confirmation",
            $"Are you sure you want to delete the board '{safeBoardName}'? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await BoardApiService.DeleteBoardAsync(board.Id);
                Snackbar.Add("Board deleted successfully.", Severity.Success);

                await BoardStore.RefreshAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to delete board: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OnPageSizeChangedAsync(int newSize)
    {
        await BoardStore.ChangePageSizeAsync(newSize);
    }

    private async Task OnSearchTermChangedAsync(string text)
    {
        await BoardStore.SetSearchTermAsync(text);
    }

}