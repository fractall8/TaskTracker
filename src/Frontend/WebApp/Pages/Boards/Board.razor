@page "/boards/{BoardId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using Contracts.Requests
@using WebApp.Shared.Dialogs
@inject IBoardDetailsStore Store
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .column-grab {
        cursor: grab;
        transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
    }

    .column-grab:active {
        cursor: grabbing;
    }

    .column-drag-active {
        opacity: 0.6;
        transform: scale(0.98);
    }

    .column-drop-target {
        border: 2px dashed var(--mud-palette-primary) !important;
        background-color: transparent !important;
        opacity: 0.8;
    }

    .task-grab {
        cursor: grab;
        transition: transform 0.1s;
    }

    .task-grab:active {
        cursor: grabbing;
    }

    .task-drag-active {
        opacity: 0.5;
        transform: scale(0.95);
    }

    .task-drop-target {
        border-top: 3px solid var(--mud-palette-primary);
        margin-top: 4px;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (Store.IsLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (!string.IsNullOrEmpty(Store.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@Store.ErrorMessage</MudAlert>
    }
    else if (Store.Board != null)
    {
        <div class="d-flex align-center mb-6">
            <MudText Typo="Typo.h4" Class="fw-bold">@Store.Board.Name</MudText>
            <MudSpacer/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       @onclick="OpenCreateColumnDialog">
                Add Column
            </MudButton>
        </div>

        <div class="d-flex flex-row gap-4 overflow-x-auto pb-4"
             style="min-height: 70vh; align-items: flex-start; flex-wrap: nowrap;">

            @foreach (var column in Store.Board.Columns)
            {
                <BoardColumn Column="column"
                             Tasks="Store.Tasks.Where(t => t.ColumnId == column.Id)"
                             IsDragged="_draggedColumn?.Id == column.Id"
                             IsDropTarget="_targetColumn?.Id == column.Id"
                             OnColumnDragStart="HandleDragStart"
                             OnColumnDragEnter="HandleDragEnter"
                             OnColumnDrop="HandleDrop"
                             OnColumnDragEnd="HandleDragEnd"
                             OnEditColumn="OpenEditColumnDialog"
                             OnDeleteColumn="DeleteColumn"

                             DraggedTaskId="_draggedTask?.Id"
                             TargetTaskId="_targetTask?.Id"
                             OnTaskDragStart="HandleTaskDragStart"
                             OnTaskDragEnter="HandleTaskDragEnter"
                             OnEmptyColumnDragEnter="HandleEmptyColumnDragEnter"
                             OnTaskDrop="HandleTaskDrop"
                             OnCreateTask="OpenCreateTaskDialog"/>
            }

            @if (!Store.Board.Columns.Any())
            {
                <MudPaper Elevation="0" Class="pa-4 d-flex justify-center align-center rounded-lg" Width="320px"
                          Style="flex-shrink: 0; border: 2px dashed #ccc; background: transparent; cursor: pointer;"
                          @onclick="OpenCreateColumnDialog">
                    <MudText Typo="Typo.body1" Color="Color.Primary">+ Create your first column</MudText>
                </MudPaper>
            }
        </div>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private ColumnDto? _draggedColumn;
    private ColumnDto? _targetColumn;
    private TaskDto? _draggedTask;
    private TaskDto? _targetTask;

    protected override async Task OnInitializedAsync()
    {
        Store.StateChanged += StateHasChanged;
        await Store.LoadAsync(BoardId);
    }

    public void Dispose() => Store.StateChanged -= StateHasChanged;

    private void HandleDragStart(ColumnDto column) => _draggedColumn = column;

    private void HandleDragEnter(ColumnDto column)
    {
        if (_draggedColumn != null && _draggedColumn.Id != column.Id) _targetColumn = column;
    }

    private async Task HandleDrop(ColumnDto column)
    {
        if (_draggedColumn == null || _targetColumn == null || _draggedColumn.Id == _targetColumn.Id)
        {
            HandleDragEnd();
            return;
        }

        var columnToMoveId = _draggedColumn.Id;
        var newPosition = _targetColumn.Position;
        HandleDragEnd();

        try
        {
            await Store.ReorderColumnsAsync(columnToMoveId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleDragEnd()
    {
        _draggedColumn = null;
        _targetColumn = null;
    }

    private void HandleTaskDragStart(TaskDto task) => _draggedTask = task;

    private void HandleTaskDragEnter(TaskDto targetTask)
    {
        if (_draggedTask != null) _targetTask = targetTask;
    }

    private void HandleEmptyColumnDragEnter(Guid columnId)
    {
        if (_draggedTask != null) _targetTask = null;
    }

    private async Task HandleTaskDrop(Guid targetColumnId)
    {
        if (_draggedTask == null) return;
        var taskToMove = _draggedTask;
        var newPosition = _targetTask?.Position ?? Store.Tasks.Count(t => t.ColumnId == targetColumnId);

        _draggedTask = null;
        _targetTask = null;

        try
        {
            await Store.MoveTaskAsync(taskToMove.Id, targetColumnId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenCreateColumnDialog()
    {
        var parameters = new DialogParameters { ["InitialName"] = string.Empty };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("New Column", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var columnName = result.Data?.ToString() ?? string.Empty;
                await Store.CreateColumnAsync(columnName);
                Snackbar.Add("Column created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenEditColumnDialog(ColumnDto column)
    {
        var parameters = new DialogParameters { ["InitialName"] = column.Name };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("Edit Column", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var newName = result.Data?.ToString() ?? string.Empty;
                await Store.UpdateColumnNameAsync(column.Id, newName);
                Snackbar.Add("Column updated successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task DeleteColumn(ColumnDto column)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Column",
            $"Are you sure you want to delete '{column.Name}'?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await Store.DeleteColumnAsync(column.Id);
                Snackbar.Add("Column deleted", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenCreateTaskDialog(Guid columnId)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Create Task", options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var request = (CreateTaskRequest)result.Data!;
                await Store.CreateTaskAsync(columnId, request);
                Snackbar.Add("Task created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}