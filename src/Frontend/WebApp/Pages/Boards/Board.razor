@page "/boards/{BoardId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using WebApp.Shared.Dialogs
@inject IBoardDetailsStore Store
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .column-grab {
        cursor: grab;
        transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
    }

    .column-grab:active {
        cursor: grabbing;
    }

    .column-drag-active {
        opacity: 0.6;
        transform: scale(0.98);
    }

    .column-drop-target {
        border: 2px dashed var(--mud-palette-primary) !important;
        background-color: transparent !important;
        opacity: 0.8;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (Store.IsLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (!string.IsNullOrEmpty(Store.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@Store.ErrorMessage</MudAlert>
    }
    else if (Store.Board != null)
    {
        <div class="d-flex align-center mb-4 gap-4">
            <MudText Typo="Typo.h5" Class="fw-bold text-truncate" Style="max-width: 500px; color: #172b4d;">
                @Store.Board.Name
            </MudText>

            <MudSpacer/>

            <MudTextField T="string"
                          Value="@_searchQuery"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Search tasks..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          Style="max-width: 250px; background-color: white;"/>
        </div>

        <MudDropContainer @ref="_dropContainer"
                          T="TaskDto"
                          Items="GetFilteredTasks()"
                          ItemsSelector="@((item, dropzone) => item.ColumnId.ToString() == dropzone)"
                          ItemDropped="TaskUpdated"
                          Class="w-100">

            <ChildContent>
                <div class="d-flex flex-row gap-4 overflow-x-auto pb-4"
                     style="min-height: 70vh; align-items: flex-start; flex-wrap: nowrap;">

                    @foreach (var column in Store.Board.Columns)
                    {
                        <BoardColumn Column="column"
                                     IsDragged="_draggedColumn?.Id == column.Id"
                                     IsDropTarget="_targetColumn?.Id == column.Id"
                                     OnColumnDragStart="HandleDragStart"
                                     OnColumnDragEnter="HandleDragEnter"
                                     OnColumnDrop="HandleDrop"
                                     OnColumnDragEnd="HandleDragEnd" />
                    }

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateColumnDialog"
                               Class="rounded-lg px-4"
                               Style="min-width: 320px; flex-shrink: 0; height: 50px; border: 2px dashed #cbd5e1; background-color: rgba(244, 245, 247, 0.5); color: #475569; justify-content: flex-start; text-transform: none; font-weight: 500;">
                        @(Store.Board.Columns.Any() ? "Add another column" : "Add a column")
                    </MudButton>

                </div>
            </ChildContent>

            <ItemRenderer>
                <TaskCard Task="context" />
            </ItemRenderer>

        </MudDropContainer>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }
    
    private ColumnDto? _draggedColumn;
    private ColumnDto? _targetColumn;
    private string _searchQuery = string.Empty;

    private MudDropContainer<TaskDto>? _dropContainer;
    
    private void OnSearchChanged(string newValue)
    {
        _searchQuery = newValue;
        _dropContainer?.Refresh();
    }
    
    protected override async Task OnInitializedAsync()
    {
        Store.StateChanged += HandleStoreStateChanged;
        await Store.LoadAsync(BoardId);
    }

    public void Dispose() => Store.StateChanged -= HandleStoreStateChanged;
    
    private void HandleStoreStateChanged()
    {
        StateHasChanged();
        _dropContainer?.Refresh();
    }

    private IEnumerable<TaskDto> GetFilteredTasks()
    {
        var tasks = Store.Tasks.OrderBy(t => t.Position).AsEnumerable();

        if (string.IsNullOrWhiteSpace(_searchQuery))
            return tasks;

        return tasks.Where(t =>
            t.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.Description != null && t.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task TaskUpdated(MudItemDropInfo<TaskDto> dropItem)
    {
        var task = dropItem.Item;
        var targetColumnId = Guid.Parse(dropItem.DropzoneIdentifier);
        var newPosition = dropItem.IndexInZone;

        try
        {
            await Store.MoveTaskAsync(task.Id, targetColumnId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to move task: {ex.Message}", Severity.Error);
        }
    }
    
    private void HandleDragStart(ColumnDto column) => _draggedColumn = column;

    private void HandleDragEnter(ColumnDto column)
    {
        if (_draggedColumn != null && _draggedColumn.Id != column.Id) _targetColumn = column;
    }

    private async Task HandleDrop(ColumnDto column)
    {
        if (_draggedColumn == null || _targetColumn == null || _draggedColumn.Id == _targetColumn.Id)
        {
            HandleDragEnd();
            return;
        }

        var columnToMoveId = _draggedColumn.Id;
        var newPosition = _targetColumn.Position;
        HandleDragEnd();
        try
        {
            await Store.ReorderColumnsAsync(columnToMoveId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleDragEnd()
    {
        _draggedColumn = null;
        _targetColumn = null;
    }

    private async Task OpenCreateColumnDialog()
    {
        var parameters = new DialogParameters { ["InitialName"] = string.Empty };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("New Column", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var columnName = result.Data?.ToString() ?? string.Empty;

                await Store.CreateColumnAsync(columnName);

                Snackbar.Add("Column created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}