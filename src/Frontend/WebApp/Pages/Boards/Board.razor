@page "/boards/{BoardId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using Contracts.Requests
@using WebApp.Shared.Dialogs
@inject IBoardDetailsStore Store
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .column-grab {
        cursor: grab;
        transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
    }

    .column-grab:active {
        cursor: grabbing;
    }

    .column-drag-active {
        opacity: 0.6;
        transform: scale(0.98);
    }

    .column-drop-target {
        border: 2px dashed var(--mud-palette-primary) !important;
        background-color: transparent !important;
        opacity: 0.8;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (Store.IsLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (!string.IsNullOrEmpty(Store.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@Store.ErrorMessage</MudAlert>
    }
    else if (Store.Board != null)
    {
        <div class="d-flex align-center mb-4 gap-4">
            <MudText Typo="Typo.h5" Class="fw-bold text-truncate" Style="max-width: 500px; color: #172b4d;">
                @Store.Board.Name
            </MudText>

            <MudSpacer/>

            <MudTextField @bind-Value="_searchQuery"
                          Placeholder="Search tasks..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          Style="max-width: 250px; background-color: white;"/>
        </div>

        <MudDropContainer T="TaskDto"
                          Items="GetFilteredTasks()"
                          ItemsSelector="@((item, dropzone) => item.ColumnId.ToString() == dropzone)"
                          ItemDropped="TaskUpdated"
                          Class="w-100">

            <ChildContent>
                <div class="d-flex flex-row gap-4 overflow-x-auto pb-4"
                     style="min-height: 70vh; align-items: flex-start; flex-wrap: nowrap;">

                    @foreach (var column in Store.Board.Columns)
                    {
                        <BoardColumn Column="column"
                                     IsDragged="_draggedColumn?.Id == column.Id"
                                     IsDropTarget="_targetColumn?.Id == column.Id"
                                     OnColumnDragStart="HandleDragStart"
                                     OnColumnDragEnter="HandleDragEnter"
                                     OnColumnDrop="HandleDrop"
                                     OnColumnDragEnd="HandleDragEnd"
                                     OnEditColumn="OpenEditColumnDialog"
                                     OnDeleteColumn="DeleteColumn"
                                     OnCreateTask="OpenCreateTaskDialog"/>
                    }

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateColumnDialog"
                               Class="rounded-lg px-4"
                               Style="min-width: 320px; flex-shrink: 0; height: 50px; border: 2px dashed #cbd5e1; background-color: rgba(244, 245, 247, 0.5); color: #475569; justify-content: flex-start; text-transform: none; font-weight: 500;">
                        @(Store.Board.Columns.Any() ? "Add another column" : "Add a column")
                    </MudButton>

                </div>
            </ChildContent>

            <ItemRenderer>
                <TaskCard Task="context"
                          OnEditClick="OpenEditTaskDialog"
                          OnDeleteClick="ConfirmDeleteTask"/>
            </ItemRenderer>

        </MudDropContainer>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private ColumnDto? _draggedColumn;
    private ColumnDto? _targetColumn;
    private string _searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Store.StateChanged += StateHasChanged;
        await Store.LoadAsync(BoardId);
    }

    public void Dispose() => Store.StateChanged -= StateHasChanged;

    private IEnumerable<TaskDto> GetFilteredTasks()
    {
        var tasks = Store.Tasks.OrderBy(t => t.Position).AsEnumerable();

        if (string.IsNullOrWhiteSpace(_searchQuery))
            return tasks;

        return tasks.Where(t =>
            t.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.Description != null && t.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task TaskUpdated(MudItemDropInfo<TaskDto> dropItem)
    {
        var task = dropItem.Item;
        var targetColumnId = Guid.Parse(dropItem.DropzoneIdentifier);
        var newPosition = dropItem.IndexInZone;

        try
        {
            await Store.MoveTaskAsync(task.Id, targetColumnId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to move task: {ex.Message}", Severity.Error);
        }
    }
    
    private void HandleDragStart(ColumnDto column) => _draggedColumn = column;

    private void HandleDragEnter(ColumnDto column)
    {
        if (_draggedColumn != null && _draggedColumn.Id != column.Id) _targetColumn = column;
    }

    private async Task HandleDrop(ColumnDto column)
    {
        if (_draggedColumn == null || _targetColumn == null || _draggedColumn.Id == _targetColumn.Id)
        {
            HandleDragEnd();
            return;
        }

        var columnToMoveId = _draggedColumn.Id;
        var newPosition = _targetColumn.Position;
        HandleDragEnd();
        try
        {
            await Store.ReorderColumnsAsync(columnToMoveId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleDragEnd()
    {
        _draggedColumn = null;
        _targetColumn = null;
    }


    private async Task OpenCreateColumnDialog()
    {
        var parameters = new DialogParameters { ["InitialName"] = string.Empty };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("New Column", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var columnName = result.Data?.ToString() ?? string.Empty;

                await Store.CreateColumnAsync(columnName);

                Snackbar.Add("Column created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }


    private async Task OpenEditColumnDialog(ColumnDto column)
    {
        var parameters = new DialogParameters { ["InitialName"] = column.Name };
        var dialog = await DialogService.ShowAsync<ColumnDialog>("Edit Column", parameters);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var newName = result.Data?.ToString() ?? string.Empty;

                await Store.UpdateColumnNameAsync(column.Id, newName);

                Snackbar.Add("Column updated successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }


    private async Task DeleteColumn(ColumnDto column)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Column",
            $"Are you sure you want to delete '{column.Name}'?",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                await Store.DeleteColumnAsync(column.Id);

                Snackbar.Add("Column deleted", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }


    private async Task OpenCreateTaskDialog(Guid columnId)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,

            MaxWidth = MaxWidth.Small,

            FullWidth = true,

            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Create Task", options);

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var request = (CreateTaskRequest)result.Data!;

                await Store.CreateTaskAsync(columnId, request);

                Snackbar.Add("Task created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }


    private async Task ConfirmDeleteTask(TaskDto task)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Task",
            $"Are you sure you want to delete '{task.Title}'?",
            yesText: "Delete", cancelText: "Cancel");


        if (result == true)
        {
            try
            {
                await Store.DeleteTaskAsync(task.Id);

                Snackbar.Add("Task deleted", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }


    private async Task OpenEditTaskDialog(TaskDto task)
    {
        var parameters = new DialogParameters { ["Task"] = task };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };


        var dialog = await DialogService.ShowAsync<EditTaskDialog>("Edit Task", parameters, options);

        var result = await dialog.Result;


        if (!result!.Canceled)
        {
            try
            {
                if (result.Data is UpdateTaskRequest request)

                {
                    await Store.UpdateTaskAsync(task.Id, request);

                    Snackbar.Add("Task updated", Severity.Success);
                }
            }

            catch (Exception ex)

            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}