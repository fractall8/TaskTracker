@page "/boards/{BoardId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using Contracts.Enums
@using Services.Abstractions.Hubs
@using WebApp.Shared.Dialogs
@inject IBoardDetailsStore BoardDetailsStore
@inject IWorkspaceStore WorkspaceStore
@inject IProfileStore ProfileStore
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IBoardExportStatusHubService ExportHubService

<style>
    .column-grab {
        cursor: grab;
        transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
    }

    .column-grab:active {
        cursor: grabbing;
    }

    .column-drag-active {
        opacity: 0.6;
        transform: scale(0.98);
    }

    .column-drop-target {
        border: 2px dashed var(--mud-palette-primary) !important;
        background-color: transparent !important;
        opacity: 0.8;
    }

    .board-horizontal-scroll::-webkit-scrollbar {
        height: 10px;
    }

    .board-horizontal-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .board-horizontal-scroll::-webkit-scrollbar-thumb {
        background: var(--mud-palette-lines-default);
        border-radius: 8px;
    }

    .board-horizontal-scroll::-webkit-scrollbar-thumb:hover {
        background: var(--mud-palette-text-secondary);
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="pt-4 px-4 px-md-8 d-flex flex-column"
              Style="height: calc(100vh - 64px); overflow: hidden;">

    <div class="mb-2 flex-shrink-0">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   Variant="Variant.Text"
                   OnClick="NavigateBack">
            Back to Workspace's Boards
        </MudButton>
    </div>

    <div class="d-flex align-center mb-4 w-100 flex-shrink-0">
        <MudText Typo="Typo.h4" Class="fw-bold text-truncate"
                 Style="max-width: 500px; color: var(--mud-palette-text-primary);">
            @(BoardDetailsStore.Board?.Name ?? "Loading Board...")
        </MudText>
        
        <div class="ml-4">
            <BoardExportControls />
        </div>

        <MudSpacer/>

        @if (_workspaceRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner)
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Group" 
                       Class="mr-4 rounded-lg"
                       OnClick="OpenManageMembersDialog">
                Manage Members
            </MudButton>
        }

        <div style="width: 300px;">
            <MudTextField T="string"
                          Value="@_searchQuery"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Search tasks..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="500"
                          Style="background-color: var(--mud-palette-surface);"
                          Disabled="@(BoardDetailsStore.Board == null)"/>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(BoardDetailsStore.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 flex-shrink-0 rounded-lg">
            @BoardDetailsStore.ErrorMessage
        </MudAlert>
    }

    @if (BoardDetailsStore.IsLoading && BoardDetailsStore.Board == null)
    {
        <div class="d-flex justify-center align-center flex-grow-1">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (BoardDetailsStore.Board != null)
    {
        @if (BoardDetailsStore.Board is { IsArchived: true })
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 rounded-lg" Icon="@Icons.Material.Filled.Archive" Style="border-width: 2px; background-color: var(--mud-palette-surface);">
                <div class="d-flex align-center justify-space-between w-100">
                    <div>
                        <MudText Typo="Typo.h6" Class="fw-bold">Archived Board</MudText>
                        <MudText Typo="Typo.body2">This board is in Read-Only mode. You can view tasks and download the archive, but no changes can be made.</MudText>
                    </div>
                </div>
            </MudAlert>
        }
        <MudDropContainer @ref="_dropContainer"
                          T="TaskDto"
                          Items="BoardDetailsStore.Tasks"
                          ItemsSelector="@((item, dropzone) => item.ColumnId.ToString() == dropzone)"
                          ItemDropped="TaskUpdated"
                          ItemDisabled="@((item) => !CanMoveTasks)"
                          CanDrop="@((_, _) => CanMoveTasks)"
                          Class="d-flex flex-column flex-grow-1 overflow-hidden w-100">

            <ChildContent>
                <div class="d-flex flex-row gap-4 overflow-x-auto flex-grow-1 pb-2 board-horizontal-scroll"
                     style="align-items: flex-start; flex-wrap: nowrap;">

                    @foreach (var column in BoardDetailsStore.Board.Columns)
                    {
                        <BoardColumn Column="column"
                                     BoardId="@BoardId"
                                     IsDragged="_draggedColumn?.Id == column.Id"
                                     IsDropTarget="_targetColumn?.Id == column.Id"
                                     CanManageColumns="CanManageColumns"
                                     CanManageTasks="CanManageTasks"
                                     OnColumnDragStart="HandleDragStart"
                                     OnColumnDragEnter="HandleDragEnter"
                                     OnColumnDrop="HandleDrop"
                                     OnColumnDragEnd="HandleDragEnd"/>
                    }

                    @if (CanManageColumns)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateColumnDialog"
                                   Class="rounded-lg px-4 flex-shrink-0"
                                   Style="width: 320px; height: 50px; border: 2px dashed var(--mud-palette-lines-default); background-color: transparent; color: var(--mud-palette-text-secondary); justify-content: flex-start; text-transform: none; font-weight: 500;">
                            @(BoardDetailsStore.Board.Columns.Any() ? "Add another column" : "Add a column")
                        </MudButton>
                    }

                </div>
            </ChildContent>

            <ItemRenderer>
                <TaskCard Task="context" 
                          BoardId="@BoardId" 
                          CanManageTasks="CanManageTasks" 
                          CanMoveTasks="CanMoveTasks" />
            </ItemRenderer>

        </MudDropContainer>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private ColumnDto? _draggedColumn;
    private ColumnDto? _targetColumn;
    private string _searchQuery = string.Empty;
    private CancellationTokenSource? _searchCts;

    private MudDropContainer<TaskDto>? _dropContainer;

    private BoardRoleDto? _boardRole => BoardDetailsStore.Board?.BoardRole;
    private WorkspaceRoleDto? _workspaceRole;

    private bool CanManageColumns => BoardDetailsStore.Board is { IsArchived: false } && 
                                     _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    private bool CanManageTasks => BoardDetailsStore.Board is { IsArchived: false } && 
                                   _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    private bool CanMoveTasks => BoardDetailsStore.Board is { IsArchived: false } && 
                                 _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster or BoardRoleDto.User;

    private async Task OnSearchChanged(string newValue)
    {
        _searchQuery = newValue;
        
        if (_searchCts != null)
        {
            await _searchCts.CancelAsync();
            _searchCts.Dispose();
        }
        
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await BoardDetailsStore.LoadAsync(BoardId, _searchQuery, token);
            _dropContainer?.Refresh();
        }
        catch (OperationCanceledException)
        {
            // skip
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        BoardDetailsStore.StateChanged += HandleStoreStateChanged;
        await BoardDetailsStore.LoadAsync(BoardId);
        await ResolveRolesAsync();
        
        await ExportHubService.ConnectAsync(BoardId);
    }

    private async Task ResolveRolesAsync()
    {
        if (BoardDetailsStore.Board != null)
        {
            _workspaceRole = WorkspaceStore.GetCachedRole(BoardDetailsStore.Board.WorkspaceId);
            
            if (_workspaceRole == null)
            {
                await WorkspaceStore.LoadWorkspaceDetailsAsync(BoardDetailsStore.Board.WorkspaceId);
                _workspaceRole = WorkspaceStore.GetCachedRole(BoardDetailsStore.Board.WorkspaceId);
            }
        }
    }

    public void Dispose()
    {
        BoardDetailsStore.StateChanged -= HandleStoreStateChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        
        _ = ExportHubService.DisconnectAsync();
    }

    private void HandleStoreStateChanged()
    {
        InvokeAsync(() => 
        {
            StateHasChanged();
            _dropContainer?.Refresh();
        });
    }

    private async Task TaskUpdated(MudItemDropInfo<TaskDto> dropItem)
    {
        if (!CanMoveTasks) return;

        var task = dropItem.Item;

        if (task == null) return;
        
        var targetColumnId = Guid.Parse(dropItem.DropzoneIdentifier);
        var newPosition = dropItem.IndexInZone;

        try
        {
            await BoardDetailsStore.MoveTaskAsync(task.Id, targetColumnId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to move task: {ex.Message}", Severity.Error);
            _dropContainer?.Refresh();
        }
    }

    private void HandleDragStart(ColumnDto column)
    {
        if (CanManageColumns) _draggedColumn = column;
    }

    private void HandleDragEnter(ColumnDto column)
    {
        if (CanManageColumns && _draggedColumn != null && _draggedColumn.Id != column.Id) _targetColumn = column;
    }

    private async Task HandleDrop(ColumnDto column)
    {
        if (!CanManageColumns || _draggedColumn == null || _targetColumn == null || _draggedColumn.Id == _targetColumn.Id)
        {
            HandleDragEnd();
            return;
        }

        var columnToMoveId = _draggedColumn.Id;
        var newPosition = _targetColumn.Position;
        HandleDragEnd();

        try
        {
            await BoardDetailsStore.ReorderColumnsAsync(columnToMoveId, newPosition);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _dropContainer?.Refresh();
        }
    }

    private void HandleDragEnd()
    {
        _draggedColumn = null;
        _targetColumn = null;
    }

    private async Task OpenCreateColumnDialog()
    {
        var parameters = new DialogParameters { ["InitialName"] = string.Empty };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("New Column", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var columnName = result.Data?.ToString() ?? string.Empty;

                await BoardDetailsStore.CreateColumnAsync(columnName);

                Snackbar.Add("Column created successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
    
    private async Task OpenManageMembersDialog()
    {
        var currentUserEmail = ProfileStore.Profile?.Email ?? string.Empty;
        
        var parameters = new DialogParameters 
        { 
            { nameof(ManageBoardMembersDialog.WorkspaceId), BoardDetailsStore.Board!.WorkspaceId }, 
            { nameof(ManageBoardMembersDialog.BoardId), BoardId },
            { nameof(ManageBoardMembersDialog.CurrentUserEmail), currentUserEmail },
            { nameof(ManageBoardMembersDialog.CurrentUserWorkspaceRole), _workspaceRole }
        };

        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        
        await DialogService.ShowAsync<ManageBoardMembersDialog>("Manage Board Members", parameters, options);
    }

    private void NavigateBack()
    {
        if (BoardDetailsStore.Board != null)
        {
            Navigation.NavigateTo($"/workspaces/{BoardDetailsStore.Board.WorkspaceId}");
        }
        else
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}