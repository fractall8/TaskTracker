@page "/boards/{BoardId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using Contracts.Enums
@using Services.Abstractions.BoardCalls
@using Services.Abstractions.Hubs
@using WebApp.Components.AppSelect
@using WebApp.Components.BoardCallIndicator
@using WebApp.Components.BoardColumn
@using WebApp.Components.BoardExportControls
@using WebApp.Components.TaskCard
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Helpers
@using WebApp.Shared.Toast
@inject IBoardDetailsStore BoardDetailsStore
@inject IBoardCallStore BoardCallStore
@inject IWorkspaceStore WorkspaceStore
@inject IProfileStore ProfileStore
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject CustomToastService Toast
@inject IBoardExportStatusHubService ExportHubService
@inject IBoardActionsHubService ActionsHubService

<PageTitle>@(IsCurrentBoardLoaded ? BoardDetailsStore.Board!.Name : "Board") - TaskTracker</PageTitle>

<main class="board-main">
    <button class="crumb crumb-btn" @onclick="NavigateBack">
        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
        Back to Workspace
    </button>

    <div class="board-head">
        <div class="board-head-left">
            <div class="card-icon @AvatarColorHelper.GetColorClass(IsCurrentBoardLoaded ? BoardDetailsStore.Board?.Name : null)">
                @(IsCurrentBoardLoaded ? BoardDetailsStore.Board!.Name.FirstOrDefault().ToString().ToUpper() : "B")
            </div>
            <h1>@(IsCurrentBoardLoaded ? BoardDetailsStore.Board!.Name : "Loading Board...")</h1>
        </div>

        <div class="board-head-right">
            <div class="search-input">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small"/>
                <input placeholder="Search tasks..."
                       value="@_searchQuery"
                       @oninput="OnSearchInput"
                       disabled="@(!IsCurrentBoardLoaded)"/>
            </div>

            <AppSelect TValue="CompletionFilter"
                       Options="_completionFilterOptions"
                       Value="_completionFilter"
                       ValueChanged="OnCompletionFilterChanged"
                       Icon="@Icons.Material.Filled.FilterList"
                       Disabled="@(!IsCurrentBoardLoaded)"
                       Width="170px"/>

            @if (BoardTags.Count > 0)
            {
                <AppSelect TValue="Guid"
                           MultiSelection="true"
                           Options="TagFilterOptions"
                           SelectedValues="_selectedTagIds"
                           SelectedValuesChanged="OnTagFilterChanged"
                           Icon="@Icons.Material.Filled.Sell"
                           Placeholder="Any tag"
                           Width="160px"/>
            }

            @if (IsCurrentBoardLoaded && BoardDetailsStore.Board is { IsArchived: false } && _workspaceRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner)
            {
                <button class="btn" @onclick="OpenManageMembersDialog">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small"/>
                    Members
                </button>
            }

            <BoardCallIndicator/>

            <BoardExportControls/>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(BoardDetailsStore.ErrorMessage))
    {
        <div class="custom-alert error mb-4 flex-shrink-0">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Class="custom-alert-icon"/>
            <div class="custom-alert-content">
                <p>@BoardDetailsStore.ErrorMessage</p>
            </div>
        </div>
    }

    @if (IsCurrentBoardLoaded && BoardDetailsStore.Board is { IsArchived: true })
    {
        <div class="custom-alert warning mb-4 flex-shrink-0">
            <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" Class="custom-alert-icon"/>
            <div class="custom-alert-content">
                <h4>Archived Board</h4>
                <p>This board is in Read-Only mode. You can view tasks and download the archive, but no changes can be
                    made.</p>
            </div>
        </div>
    }

    @if (BoardDetailsStore.IsLoading || !IsCurrentBoardLoaded)
    {
        <div class="d-flex justify-center align-center flex-grow-1">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else
    {
        <MudDropContainer @ref="_dropContainer"
                          T="TaskDto"
                          Items="VisibleTasks"
                          ItemsSelector="@((item, dropzone) => item.ColumnId.ToString() == dropzone)"
                          ItemDropped="TaskUpdated"
                          ItemDisabled="@((item) => !CanMoveTasks)"
                          CanDrop="@((_, _) => CanMoveTasks)"
                          Class="board-drop-container">
            <ChildContent>
                <div class="board-columns">
                    @foreach (var column in BoardDetailsStore.Board!.Columns)
                    {
                        <BoardColumn Column="column"
                                     BoardId="@BoardId"
                                     IsDragged="_draggedColumn?.Id == column.Id"
                                     IsDropTarget="_targetColumn?.Id == column.Id"
                                     CanManageColumns="CanManageColumns"
                                     CanManageTasks="CanManageTasks"
                                     OnColumnDragStart="HandleDragStart"
                                     OnColumnDragEnter="HandleDragEnter"
                                     OnColumnDrop="HandleDrop"
                                     OnColumnDragEnd="HandleDragEnd"/>
                    }

                    @if (CanManageColumns)
                    {
                        <div class="column-add" @onclick="OpenCreateColumnDialog">
                            <button class="add-column-btn">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                                @(BoardDetailsStore.Board.Columns.Any() ? "Add another column" : "Add column")
                            </button>
                        </div>
                    }
                </div>
            </ChildContent>

            <ItemRenderer>
                <TaskCard Task="context"
                          BoardId="@BoardId"
                          CanManageTasks="CanManageTasks"
                          CanMoveTasks="CanMoveTasks"
                          CanCompleteTasks="CanCompleteTasks"/>
            </ItemRenderer>
        </MudDropContainer>
    }
</main>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private Guid _loadedBoardId;
    private ColumnDto? _draggedColumn;
    private ColumnDto? _targetColumn;
    private string _searchQuery = string.Empty;
    private CancellationTokenSource? _searchCts;

    private MudDropContainer<TaskDto>? _dropContainer;

    private bool IsCurrentBoardLoaded => BoardDetailsStore.Board != null && BoardDetailsStore.Board.Id == BoardId;

    private BoardRoleDto? _boardRole => BoardDetailsStore.Board?.BoardRole;
    private WorkspaceRoleDto? _workspaceRole;

    private BoardExportStatusDto? _lastExportStatus;
    private BoardExportStatusDto? _lastReExportStatus;

    private bool CanManageColumns => IsCurrentBoardLoaded && BoardDetailsStore.Board is { IsArchived: false } &&
                                     _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    private bool CanManageTasks => IsCurrentBoardLoaded && BoardDetailsStore.Board is { IsArchived: false } &&
                                   _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    private bool CanMoveTasks => IsCurrentBoardLoaded && BoardDetailsStore.Board is { IsArchived: false } &&
                                 _boardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster or BoardRoleDto.User;

    private bool CanCompleteTasks => CanMoveTasks;

    private bool IsFiltered => _completionFilter != CompletionFilter.All || _selectedTagIds.Count > 0;

    // Only tags actually in use on this board, so the control never offers a filter that matches nothing.
    private List<TagDto> BoardTags =>
        [.. BoardDetailsStore.Tasks
            .SelectMany(task => task.Tags)
            .DistinctBy(tag => tag.Id)
            .OrderBy(tag => tag.Name)];

    private IEnumerable<TaskDto> VisibleTasks => BoardDetailsStore.Tasks.Where(IsVisible);

    private bool IsVisible(TaskDto task)
    {
        var matchesCompletion = _completionFilter switch
        {
            CompletionFilter.Outstanding => !task.IsCompleted,
            CompletionFilter.Completed => task.IsCompleted,
            _ => true
        };

        return matchesCompletion
               && (_selectedTagIds.Count == 0 || task.Tags.Any(tag => _selectedTagIds.Contains(tag.Id)));
    }

    // A drop reports its index among the rendered cards, but the server reads the position as an index
    // among all tasks in the column. Anchor on the card the task landed in front of and use its real
    // index; with no filter the two lists are identical and this returns indexInZone unchanged.
    private int ResolveDropPosition(Guid targetColumnId, int indexInZone)
    {
        if (!IsFiltered)
        {
            return indexInZone;
        }

        var columnTasks = BoardDetailsStore.Tasks
            .Where(task => task.ColumnId == targetColumnId)
            .OrderBy(task => task.Position)
            .ToList();

        var visible = columnTasks.Where(IsVisible).ToList();

        if (indexInZone >= visible.Count)
        {
            return columnTasks.Count;
        }

        var anchor = visible[indexInZone];

        return columnTasks.FindIndex(task => task.Id == anchor.Id);
    }

    private IReadOnlyCollection<Guid> _selectedTagIds = [];

    private IReadOnlyList<AppSelectOption<Guid>> TagFilterOptions =>
        [.. BoardTags.Select(tag => new AppSelectOption<Guid>(tag.Id, tag.Name))];

    private void OnTagFilterChanged(IReadOnlyCollection<Guid> selected)
    {
        _selectedTagIds = selected;
        _dropContainer?.Refresh();
    }

    private enum CompletionFilter
    {
        All,
        Outstanding,
        Completed
    }

    private CompletionFilter _completionFilter = CompletionFilter.All;

    private readonly IReadOnlyList<AppSelectOption<CompletionFilter>> _completionFilterOptions =
    [
        new(CompletionFilter.All, "All tasks"),
        new(CompletionFilter.Outstanding, "Not completed"),
        new(CompletionFilter.Completed, "Completed")
    ];

    private void OnCompletionFilterChanged(CompletionFilter filter)
    {
        _completionFilter = filter;
        _dropContainer?.Refresh();
    }

    protected override void OnInitialized()
    {
        BoardDetailsStore.StateChanged += HandleStoreStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedBoardId != BoardId)
        {
            BoardDetailsStore.Reset();
            BoardCallStore.Reset();

            _loadedBoardId = BoardId;
            _searchQuery = string.Empty;

            if (_loadedBoardId != Guid.Empty)
            {
                await ExportHubService.DisconnectAsync();
                await ActionsHubService.DisconnectAsync();
            }

            await BoardDetailsStore.LoadAsync(BoardId);

            _lastExportStatus = BoardDetailsStore.Board?.ExportStatus;
            _lastReExportStatus = BoardDetailsStore.Board?.ReExportStatus;

            await ResolveRolesAsync();
            await ExportHubService.ConnectAsync(BoardId);

            if (BoardDetailsStore.Board is { IsArchived: false })
            {
                await ActionsHubService.ConnectAsync(BoardId);
                await BoardCallStore.LoadActiveCallAsync(BoardId);
            }
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;

        if (_searchCts != null)
        {
            await _searchCts.CancelAsync();
            _searchCts.Dispose();
        }

        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(500, token);

            if (!token.IsCancellationRequested)
            {
                await BoardDetailsStore.LoadAsync(BoardId, _searchQuery, token);
                _dropContainer?.Refresh();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task ResolveRolesAsync()
    {
        if (BoardDetailsStore.Board != null)
        {
            _workspaceRole = WorkspaceStore.GetCachedRole(BoardDetailsStore.Board.WorkspaceId);

            if (_workspaceRole == null)
            {
                await WorkspaceStore.LoadWorkspaceDetailsAsync(BoardDetailsStore.Board.WorkspaceId);
                _workspaceRole = WorkspaceStore.GetCachedRole(BoardDetailsStore.Board.WorkspaceId);
            }
        }
    }

    public void Dispose()
    {
        BoardDetailsStore.StateChanged -= HandleStoreStateChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();

        _ = ExportHubService.DisconnectAsync();
    }

    private void HandleStoreStateChanged()
    {
        var currentExportStatus = BoardDetailsStore.Board?.ExportStatus;
        var currentReExportStatus = BoardDetailsStore.Board?.ReExportStatus;

        if (_lastExportStatus is BoardExportStatusDto.Requested or BoardExportStatusDto.Pending or BoardExportStatusDto.Processing
            && currentExportStatus is BoardExportStatusDto.Completed)
        {
            Toast.ShowSuccess("Archive generated successfully");
        }

        if (_lastReExportStatus is BoardExportStatusDto.Requested or BoardExportStatusDto.Pending or BoardExportStatusDto.Processing
            && currentReExportStatus is BoardExportStatusDto.None)
        {
            Toast.ShowSuccess("Archive updated successfully");
        }

        _lastExportStatus = currentExportStatus;
        _lastReExportStatus = currentReExportStatus;

        InvokeAsync(() =>
        {
            StateHasChanged();
            _dropContainer?.Refresh();
        });
    }

    private async Task TaskUpdated(MudItemDropInfo<TaskDto> dropItem)
    {
        if (!CanMoveTasks) return;

        var task = dropItem.Item;
        if (task == null) return;

        var targetColumnId = Guid.Parse(dropItem.DropzoneIdentifier);
        var newPosition = ResolveDropPosition(targetColumnId, dropItem.IndexInZone);

        try
        {
            await BoardDetailsStore.MoveTaskAsync(task.Id, targetColumnId, newPosition);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to move task: {ex.Message}");
            _dropContainer?.Refresh();
        }
    }

    private void HandleDragStart(ColumnDto column)
    {
        if (CanManageColumns) _draggedColumn = column;
    }

    private void HandleDragEnter(ColumnDto column)
    {
        if (CanManageColumns && _draggedColumn != null && _draggedColumn.Id != column.Id) _targetColumn = column;
    }

    private async Task HandleDrop(ColumnDto column)
    {
        if (!CanManageColumns || _draggedColumn == null || _targetColumn == null || _draggedColumn.Id == _targetColumn.Id)
        {
            HandleDragEnd();
            return;
        }

        var columnToMoveId = _draggedColumn.Id;
        var newPosition = _targetColumn.Position;
        HandleDragEnd();

        try
        {
            await BoardDetailsStore.ReorderColumnsAsync(columnToMoveId, newPosition);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
            _dropContainer?.Refresh();
        }
    }

    private void HandleDragEnd()
    {
        _draggedColumn = null;
        _targetColumn = null;
    }

    private async Task OpenCreateColumnDialog()
    {
        var parameters = new DialogParameters { ["InitialName"] = string.Empty };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("New Column", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var columnName = result.Data?.ToString() ?? string.Empty;
                await BoardDetailsStore.CreateColumnAsync(columnName);
                Toast.ShowSuccess("Column created successfully");
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task OpenManageMembersDialog()
    {
        if (BoardDetailsStore.Board is not { IsArchived: false }) return;

        var currentUserEmail = ProfileStore.Profile?.Email ?? string.Empty;

        var parameters = new DialogParameters
        {
            { nameof(ManageBoardMembersDialog.WorkspaceId), BoardDetailsStore.Board!.WorkspaceId },
            { nameof(ManageBoardMembersDialog.BoardId), BoardId },
            { nameof(ManageBoardMembersDialog.CurrentUserEmail), currentUserEmail },
            { nameof(ManageBoardMembersDialog.CurrentUserWorkspaceRole), _workspaceRole }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<ManageBoardMembersDialog>("Manage Board Members", parameters, options);
    }

    private void NavigateBack()
    {
        if (IsCurrentBoardLoaded)
        {
            Navigation.NavigateTo($"/workspaces/{BoardDetailsStore.Board!.WorkspaceId}");
        }
        else
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}