@page "/not-found"
@layout BlankLayout
@inject NavigationManager NavigationManager

<PageTitle>404 - Page Not Found</PageTitle>

<div class="not-found-container">
    <div class="not-found-content">
        <div class="icon-wrapper">
            <MudIcon Icon="@Icons.Material.Outlined.NotListedLocation" Style="font-size: 40px;" />
        </div>
        
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Page not found</h2>
        
        <p class="error-desc">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
        </p>

        <button class="btn btn-primary btn-lg" @onclick="GoHome">
            <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" />
            Back to Home
        </button>
    </div>
</div>

<style>
    .not-found-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px);
        padding: 24px;
        text-align: center;
    }

    .not-found-content {
        max-width: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: fadeIn 0.4s ease-out forwards;
    }

    .icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: rgba(92, 88, 214, 0.1);
        color: var(--mud-palette-primary);
        margin-bottom: 24px;
        box-shadow: 0 8px 30px rgba(92, 88, 214, 0.15);
    }

    .error-code {
        font-size: 56px;
        font-weight: 800;
        margin: 0 0 4px 0;
        color: var(--mud-palette-text-primary);
        line-height: 1.1;
        letter-spacing: -1px;
    }

    .error-title {
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 16px 0;
        color: var(--mud-palette-text-primary);
    }

    .error-desc {
        font-size: 14.5px;
        color: var(--mud-palette-text-secondary);
        line-height: 1.6;
        margin: 0 0 32px 0;
    }

    .btn-lg {
        height: 44px;
        padding: 0 24px;
        font-size: 14.5px;
        border-radius: 10px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}