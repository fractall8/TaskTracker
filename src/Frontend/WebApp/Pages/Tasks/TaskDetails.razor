@page "/boards/{BoardId:guid}/tasks/{TaskId:guid}"
@using Contracts.DTOs
@using Contracts.Requests
@using Services.Abstractions.Tasks
@using WebApp.Shared.Dialogs
@inject ITaskApiService TaskApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 pb-8">
    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (_task != null)
    {
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   Class="mb-4"
                   OnClick="@(() => Navigation.NavigateTo($"/boards/{BoardId}"))">
            Back to Board
        </MudButton>

        <MudGrid>
            <MudItem xs="12" md="8">
                
                <div class="d-flex justify-space-between align-start mb-4 gap-4">
                    <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #172b4d;">@_task.Title</MudText>
                    <MudButton StartIcon="@Icons.Material.Outlined.Edit" 
                               Variant="Variant.Outlined" 
                               Color="Color.Default"
                               Size="Size.Small" 
                               Style="white-space: nowrap;"
                               OnClick="OpenEditTaskDialog">
                        Edit Task
                    </MudButton>
                </div>

                <MudPaper Elevation="0" Class="pa-4 mb-6" Style="border: 1px solid #e0e0e0; background-color: #fafbfc;">
                    <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 600;">Description</MudText>
                    @if (!string.IsNullOrWhiteSpace(_task.Description))
                    {
                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap; color: #172b4d;">@_task.Description</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color: #5e6c84; font-style: italic;">No description provided.</MudText>
                    }
                </MudPaper>

                <TaskAttachments BoardId="BoardId" TaskId="TaskId" Attachments="_task.Attachments" />

                <MudDivider Class="my-8" />
                
                <TaskComments BoardId="BoardId" TaskId="TaskId" />
                
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #e0e0e0;">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">Task Details</MudText>

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #5e6c84;">Created By</MudText>
                            <div class="d-flex align-center gap-2 mt-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary">U</MudAvatar>
                                <MudText Typo="Typo.body2">User ID: @(_task.ReporterId.ToString() ?? "System")</MudText>
                            </div>
                        </div>

                        <MudDivider/>

                        <div>
                            <MudText Typo="Typo.caption" Style="color: #5e6c84;">Due Date</MudText>
                            <MudText Typo="Typo.body2">
                                @(_task.DueDate.HasValue ? _task.DueDate.Value.ToString("MMM dd, yyyy") : "No due date")
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private TaskDto? _task;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        try
        {
            _isLoading = true;
            _task = await TaskApi.GetTaskByIdAsync(BoardId, TaskId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters { ["Task"] = _task };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<EditTaskDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is UpdateTaskRequest request)
        {
            try
            {
                var updatedTask = await TaskApi.UpdateTaskAsync(BoardId, TaskId, request);
                var currentAttachments = _task?.Attachments;
                
                _task = updatedTask with { Attachments = currentAttachments ?? new List<AttachmentDto>() };
                
                Snackbar.Add("Task updated", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}