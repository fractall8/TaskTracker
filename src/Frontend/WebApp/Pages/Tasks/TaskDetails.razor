@page "/boards/{BoardId:guid}/tasks/{TaskId:guid}"
@using Contracts.DTOs
@using Refit
@using Services.Abstractions.Tasks
@inject ITaskApiService TaskApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 pb-8">
    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (_task != null)
    {
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   Class="mb-4"
                   OnClick="@(() => Navigation.NavigateTo($"/boards/{BoardId}"))">
            Back to Board
        </MudButton>

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h4" Class="fw-bold mb-4" Style="color: #172b4d;">@_task.Title</MudText>

                <MudPaper Elevation="0" Class="pa-4 mb-6" Style="border: 1px solid #e0e0e0; background-color: #fafbfc;">
                    <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 600;">Description</MudText>
                    @if (!string.IsNullOrWhiteSpace(_task.Description))
                    {
                        <MudText Typo="Typo.body1"
                                 Style="white-space: pre-wrap; color: #172b4d;">@_task.Description</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color: #5e6c84; font-style: italic;">No description
                            provided.
                        </MudText>
                    }
                </MudPaper>

                <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">Attachments</MudText>

                <div class="d-flex flex-column gap-2 mb-4" style="max-width: 400px;">

                    <div class="@(_selectedFile == null ? "" : "d-none")">
                        <MudFileUpload T="IBrowserFile" @bind-Files="_selectedFile"
                                       Accept=".pdf,.doc,.docx,.png,.jpg,.jpeg">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.AttachFile"
                                           Color="Color.Primary">
                                    Select File
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>

                    @if (_selectedFile != null)
                    {
                        <MudPaper Elevation="0" Class="pa-3 d-flex align-center justify-space-between rounded-lg"
                                  Style="border: 1px solid #e0e0e0; background-color: #f8fafc;">
                            <div class="d-flex align-center gap-2"
                                 style="overflow: hidden; flex-grow: 1; padding-right: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Default"
                                         Size="Size.Small"/>
                                <MudText Typo="Typo.body2" Class="text-truncate"
                                         Style="font-weight: 500; color: #172b4d;">
                                    @_selectedFile.Name
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: #5e6c84; flex-shrink: 0;">
                                    (@(Math.Round(_selectedFile.Size / 1024.0, 1)) KB)
                                </MudText>
                            </div>

                            <div class="d-flex align-center gap-2" style="flex-shrink: 0;">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="SubmitUploadAsync"
                                           Disabled="_isUploading">
                                    @(_isUploading ? "Uploading..." : "Upload")
                                </MudButton>

                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="ClearSelectedFile"
                                               Disabled="_isUploading"/>
                            </div>
                        </MudPaper>
                    }
                </div>

                @if (_task.Attachments != null && _task.Attachments.Any())
                {
                    <MudGrid Spacing="2">
                        @foreach (var attachment in _task.Attachments.OrderByDescending(a => a.CreatedAt))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Elevation="0" Class="pa-3 d-flex align-center gap-3"
                                          Style="border: 1px solid #e0e0e0;">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Default"
                                             Size="Size.Large"/>
                                    <div class="d-flex flex-column" style="overflow: hidden;">
                                        <MudLink Href="@attachment.FileUrl" Target="_blank" Typo="Typo.body2"
                                                 Class="text-truncate" Style="font-weight: 500;">
                                            @attachment.FileName
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Style="color: #5e6c84;">
                                            @(Math.Round(attachment.SizeInBytes / 1024.0, 1)) KB
                                        </MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: #5e6c84;">No attachments yet.</MudText>
                }
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #e0e0e0;">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">Task Details</MudText>

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #5e6c84;">Created By</MudText>
                            <div class="d-flex align-center gap-2 mt-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary">U</MudAvatar>
                                <MudText Typo="Typo.body2">User ID: @(_task.ReporterId.ToString() ?? "System")</MudText>
                            </div>
                        </div>

                        <MudDivider/>

                        <div>
                            <MudText Typo="Typo.caption" Style="color: #5e6c84;">Due Date</MudText>
                            <MudText Typo="Typo.body2">
                                @(_task.DueDate.HasValue ? _task.DueDate.Value.ToString("MMM dd, yyyy") : "No due date")
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private TaskDto? _task;
    private bool _isLoading = true;
    private bool _isUploading = false;
    private IBrowserFile? _selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        try
        {
            _isLoading = true;
            _task = await TaskApi.GetTaskByIdAsync(BoardId, TaskId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
    }

    private async Task SubmitUploadAsync()
    {
        if (_selectedFile == null) return;

        const long maxAllowedSize = 10 * 1024 * 1024;

        if (_selectedFile.Size > maxAllowedSize)
        {
            Snackbar.Add("File is too large (max 10MB).", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;
            StateHasChanged();

            using var stream = _selectedFile.OpenReadStream(maxAllowedSize);
            var streamPart = new StreamPart(stream, _selectedFile.Name, _selectedFile.ContentType);

            var newAttachment = await TaskApi.UploadAttachmentAsync(BoardId, TaskId, streamPart);

            _task?.Attachments?.Add(newAttachment);

            Snackbar.Add("File uploaded successfully", Severity.Success);

            _selectedFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

}