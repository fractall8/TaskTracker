@page "/boards/{BoardId:guid}/tasks/{TaskId:guid}"
@implements IDisposable
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Tasks
@using Services.Abstractions.Config
@using Services.Abstractions.Tags
@using Services.Abstractions.Tasks
@using WebApp.Components.Completion
@using WebApp.Components.Tags
@using WebApp.Components.TaskAttachment
@using WebApp.Components.TaskComments
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Helpers
@using WebApp.Shared.Toast
@inject ITaskDetailsStore TaskStore
@inject IBoardDetailsStore BoardDetailsStore
@inject ITagStore TagStore
@inject IAppConfigStore AppConfig
@inject NavigationManager Navigation
@inject CustomToastService Toast
@inject IDialogService DialogService

<main class="main task-main">
    <button class="crumb crumb-btn" @onclick="@(() => Navigation.NavigateTo($"/boards/{BoardId}"))">
        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
        Back to board
    </button>

    @if (TaskStore.IsLoading || (BoardDetailsStore.IsLoading && BoardDetailsStore.Board == null))
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (TaskStore.Task != null)
    {
        @if (IsArchived)
        {
            <div class="custom-alert warning mb-6 flex-shrink-0">
                <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" Class="custom-alert-icon"/>
                <div class="custom-alert-content">
                    <h4>Archived Board</h4>
                    <p>This board is archived. The task and its details are in Read-Only mode.</p>
                </div>
            </div>
        }

        <div class="task-detail-grid">
            <div class="task-detail-main">
                <div class="task-detail-head">
                    <h1>@TaskStore.Task.Title</h1>
                    @if (CanManageTasks)
                    {
                        <button class="icon-btn sm ghost" aria-label="Edit task info" @onclick="OpenEditTaskDialog">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                        </button>
                    }
                </div>

                <section class="task-section">
                    <p class="task-section-title">Description</p>
                    @if (!string.IsNullOrWhiteSpace(TaskStore.Task.Description))
                    {
                        <p class="task-desc-full">@TaskStore.Task.Description</p>
                    }
                    else
                    {
                        <p class="task-desc-placeholder">No description yet. Click the edit icon to add one.</p>
                    }
                </section>

                <div class="task-section mt-8">
                    <TaskAttachment BoardId="BoardId" TaskId="TaskId" IsReadOnly="IsArchived"/>
                </div>

                <div class="task-section mt-8">
                    <TaskComments BoardId="BoardId" TaskId="TaskId" IsReadOnly="IsArchived"/>
                </div>
            </div>

            <aside class="task-detail-side">
                <div class="side-meta-row">
                    <p class="info-label">Created by</p>
                    <div class="cell-member">
                        <div class="avatar-round @AvatarColorHelper.GetColorClass(TaskStore.Task.ReporterName)">
                            @if (!string.IsNullOrEmpty(TaskStore.Task.ReporterAvatarUrl))
                            {
                                <img src="@TaskStore.Task.ReporterAvatarUrl" alt="Avatar"
                                     style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                            }
                            else
                            {
                                @GetInitials(TaskStore.Task.ReporterName)
                            }
                        </div>
                        <span class="info-value"
                              style="font-size: 13px">@(TaskStore.Task.ReporterName ?? "Unknown User")</span>
                    </div>
                </div>

                <div class="side-meta-row mt-2">
                    <p class="info-label">Assignee</p>
                    <button class="fake-select" style="width: 100%; justify-content: space-between;"
                            @onclick="OpenEditTaskDialog" disabled="@(!CanManageTasks)">
                        <span style="display: flex; align-items: center; gap: 8px;">
                            @if (TaskStore.Task.AssigneeId.HasValue)
                            {
                                <span
                                    class="avatar-round tiny @AvatarColorHelper.GetColorClass(TaskStore.Task.AssigneeName)">
                                    @if (!string.IsNullOrEmpty(TaskStore.Task.AssigneeAvatarUrl))
                                    {
                                        <img src="@TaskStore.Task.AssigneeAvatarUrl" alt="Avatar"
                                             style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                                    }
                                    else
                                    {
                                        @GetInitials(TaskStore.Task.AssigneeName)
                                    }
                                </span>
                                @(TaskStore.Task.AssigneeName ?? "Unknown User")
                            }
                            else
                            {
                                <span>Unassigned</span>
                            }
                        </span>
                        @if (CanManageTasks)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"/>
                        }
                    </button>
                </div>

                <div class="side-meta-row mt-2">
                    <p class="info-label">Status</p>

                    <StatusToggle Completed="TaskStore.Task.IsCompleted"
                                  CompletedChanged="OnCompletionChangedAsync"
                                  Disabled="@(!CanCompleteTasks || _isTogglingCompletion)"/>

                    @if (TaskStore.Task is { IsCompleted: true, CompletedAt: { } completedAt })
                    {
                        <p class="status-completed-at">Completed @completedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
                    }
                </div>

                <div class="side-meta-row mt-2">
                    <p class="info-label">Tags</p>

                    @if (CanTagTasks)
                    {
                        <TagPicker Selected="TaskStore.Task.Tags"
                                   Catalogue="TagStore.Tags"
                                   Busy="_isUpdatingTags"
                                   OnAttach="AttachTagAsync"
                                   OnDetach="DetachTagAsync"
                                   OnCreate="CreateAndAttachTagAsync"/>
                    }
                    else if (TaskStore.Task.Tags.Count > 0)
                    {
                        <div class="task-tag-list">
                            @foreach (var tag in TaskStore.Task.Tags)
                            {
                                <TagChip Tag="tag" Small="true" @key="tag.Id"/>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="task-tags-empty">No tags</p>
                    }
                </div>

                <div class="side-meta-row mt-2" style="position: relative;">
                    <p class="info-label">Due date</p>

                    <div style="position: absolute; width: 0; height: 0; overflow: hidden;">
                        <MudDatePicker @ref="_datePicker"
                                       Date="TaskStore.Task.DueDate?.ToLocalTime().Date"
                                       DateChanged="OnDueDateChanged"
                                       PickerVariant="PickerVariant.Dialog"
                                       Clearable="true"/>
                    </div>

                    <button class="fake-select"
                            style="width: 100%; justify-content: space-between; height: auto; min-height: 36px; padding-top: 6px; padding-bottom: 6px;"
                            @onclick="OpenDatePickerAsync" disabled="@(!CanManageTasks)">
                        <span style="display: flex; align-items: center; gap: 8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small"
                                     Style="flex-shrink: 0;"/>
                            @{ var due = GetDueInfo(TaskStore.Task.DueDate, TaskStore.Task.IsCompleted); }

                            <span class="d-flex flex-column align-start text-left" style="line-height: 1.3;">
                                <span class="due-text due-@due.tone">@due.dateStr</span>
                                @if (!string.IsNullOrEmpty(due.statusStr))
                                {
                                    <span class="due-@due.tone"
                                          style="font-size: 11.5px; opacity: 0.85;">@due.statusStr</span>
                                }
                            </span>
                        </span>
                        @if (CanManageTasks)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                     Style="flex-shrink: 0;"/>
                        }
                    </button>
                </div>
            </aside>
        </div>
    }
</main>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private MudDatePicker _datePicker = null!;

    private bool _isTogglingCompletion;

    private bool IsArchived => BoardDetailsStore.Board?.IsArchived == true;
    private bool CanManageTasks => !IsArchived && BoardDetailsStore.Board?.BoardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    // Matches the server: completing is permitted wherever moving is, so a User can close their own work.
    private bool CanCompleteTasks => !IsArchived &&
                                     BoardDetailsStore.Board?.BoardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster or BoardRoleDto.User;

    private bool _isUpdatingTags;

    private bool CanTagTasks => CanCompleteTasks;

    // Creating from the picker also attaches, so a new tag never needs a trip to workspace settings.
    private async Task CreateAndAttachTagAsync((string Name, string Color) request)
    {
        if (_isUpdatingTags || BoardDetailsStore.Board is not { } board) return;

        _isUpdatingTags = true;

        try
        {
            var created = await TagStore.CreateAsync(board.WorkspaceId, request.Name, request.Color);

            await TaskStore.AttachTagAsync(BoardId, TaskId, created.Id);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to create tag: {ex.Message}");
        }
        finally
        {
            _isUpdatingTags = false;
        }
    }

    private async Task AttachTagAsync(TagDto tag)
    {
        if (_isUpdatingTags) return;

        _isUpdatingTags = true;

        try
        {
            await TaskStore.AttachTagAsync(BoardId, TaskId, tag.Id);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to add tag: {ex.Message}");
        }
        finally
        {
            _isUpdatingTags = false;
        }
    }

    private async Task DetachTagAsync(TagDto tag)
    {
        if (_isUpdatingTags) return;

        _isUpdatingTags = true;

        try
        {
            await TaskStore.DetachTagAsync(BoardId, TaskId, tag.Id);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to remove tag: {ex.Message}");
        }
        finally
        {
            _isUpdatingTags = false;
        }
    }

    private async Task OnCompletionChangedAsync(bool isCompleted)
    {
        if (!CanCompleteTasks || _isTogglingCompletion) return;

        _isTogglingCompletion = true;

        try
        {
            await TaskStore.SetTaskCompletionAsync(BoardId, TaskId, isCompleted);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to update task: {ex.Message}");
        }
        finally
        {
            _isTogglingCompletion = false;
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[1][..1]).ToUpper();
    }

    private (string dateStr, string statusStr, string tone) GetDueInfo(DateTimeOffset? dueDate, bool isCompleted)
    {
        if (!dueDate.HasValue) return ("No due date", "", "muted");

        // The deployment's business zone, not the browser's, so this agrees with the stats tab and the
        // assistant about which day it is (see resources/FIX-overdue-timezone.md).
        var zone = TimeSpan.FromMinutes(AppConfig.UtcOffsetMinutes);
        var today = DateTimeOffset.UtcNow.ToOffset(zone).Date;
        var due = dueDate.Value.ToOffset(zone).Date;
        var diff = (int)(due - today).TotalDays;

        var dateStr = due.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);

        // A due date only describes outstanding work, so a finished task is never late or upcoming.
        if (isCompleted) return (dateStr, "", "muted");

        if (diff < 0) return (dateStr, $"Overdue by {-diff} day{(-diff == 1 ? "" : "s")}", "danger");
        if (diff == 0) return (dateStr, "Due today", "warning");
        if (diff <= 2) return (dateStr, diff == 1 ? "Due tomorrow" : $"Due in {diff} days", "default");

        return (dateStr, $"Due in {diff} days", "default");
    }

    protected override async Task OnInitializedAsync()
    {
        TaskStore.StateChanged += StateHasChanged;

        if (BoardDetailsStore.Board?.Id != BoardId)
        {
            await BoardDetailsStore.LoadAsync(BoardId);
        }

        await AppConfig.EnsureLoadedAsync();
        await TaskStore.LoadAsync(BoardId, TaskId);

        if (BoardDetailsStore.Board is { } board)
        {
            await TagStore.LoadAsync(board.WorkspaceId);
        }
    }

    public void Dispose()
    {
        TaskStore.StateChanged -= StateHasChanged;
    }

    private async Task OpenDatePickerAsync()
    {
        await _datePicker.OpenAsync();
    }

    private async Task OnDueDateChanged(DateTime? newDate)
    {
        if (TaskStore.Task == null) return;

        DateTimeOffset? newOffset = null;
        if (newDate.HasValue)
        {
            var localDate = DateTime.SpecifyKind(newDate.Value.Date, DateTimeKind.Local);
            newOffset = new DateTimeOffset(localDate).ToUniversalTime();
        }

        if (TaskStore.Task.DueDate == newOffset) return;

        try
        {
            var request = new UpdateTaskDueDateRequest(newOffset);
            await TaskStore.UpdateTaskDueDateAsync(BoardId, TaskId, request);
            Toast.ShowSuccess("Due date updated");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { x => x.Task, TaskStore.Task },
            { x => x.BoardId, BoardId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            if (result.Data is UpdateTaskRequest request)
            {
                try
                {
                    await TaskStore.UpdateTaskAsync(BoardId, TaskId, request);
                    Toast.ShowSuccess("Task updated");
                }
                catch (Exception ex)
                {
                    Toast.ShowError(ex.Message);
                }
            }
            else if (result.Data?.ToString() == "DELETE")
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    "Delete Task",
                    "Are you sure you want to delete this task? This action cannot be undone.",
                    yesText: "Delete", cancelText: "Cancel");

                if (confirmed == true)
                {
                    try
                    {
                        await TaskStore.DeleteTaskAsync(BoardId, TaskId);
                        Toast.ShowSuccess("Task deleted");
                        Navigation.NavigateTo($"/boards/{BoardId}");
                    }
                    catch (Exception ex)
                    {
                        Toast.ShowError(ex.Message);
                    }
                }
            }
        }
    }

}