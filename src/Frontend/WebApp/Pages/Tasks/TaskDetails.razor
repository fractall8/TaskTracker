@page "/boards/{BoardId:guid}/tasks/{TaskId:guid}"
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Tasks
@using Services.Abstractions.Tasks
@using WebApp.Shared.Dialogs
@inject ITaskApiService TaskApi
@inject IBoardDetailsStore BoardDetailsStore
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .task-scroll-area::-webkit-scrollbar {
        width: 8px;
    }

    .task-scroll-area::-webkit-scrollbar-track {
        background: transparent;
    }

    .task-scroll-area::-webkit-scrollbar-thumb {
        background: var(--mud-palette-lines-default);
        border-radius: 8px;
    }

    .task-scroll-area::-webkit-scrollbar-thumb:hover {
        background: var(--mud-palette-text-secondary);
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 px-4 d-flex flex-column"
              Style="height: calc(100vh - 64px); overflow: hidden;">

    @if (_isLoading || (BoardDetailsStore.IsLoading && BoardDetailsStore.Board == null))
    {
        <div class="d-flex justify-center align-center flex-grow-1">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (_task != null)
    {
        <div class="mb-4 flex-shrink-0">
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo($"/boards/{BoardId}"))">
                Back to Board
            </MudButton>
        </div>

        @if (IsArchived)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 rounded-lg flex-shrink-0"
                      Icon="@Icons.Material.Filled.Archive"
                      Style="border-width: 2px; background-color: var(--mud-palette-surface);">
                This board is archived. The task and its details are in Read-Only mode.
            </MudAlert>
        }

        <div class="d-flex flex-column flex-md-row gap-6 flex-grow-1 overflow-hidden w-100 pb-4">

            <div class="d-flex flex-column flex-grow-1 overflow-hidden" style="min-width: 0;">

                <div class="d-flex justify-space-between align-start mb-4 gap-4 flex-shrink-0 w-100">

                    <div style="flex-grow: 1; min-width: 0;">
                        <MudText Typo="Typo.h4" Class="fw-bold"
                                 Style="color: var(--mud-palette-text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;">
                            @_task.Title
                        </MudText>
                    </div>

                    @if (CanManageTasks)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Edit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   Class="flex-shrink-0"
                                   Style="white-space: nowrap;"
                                   OnClick="OpenEditTaskDialog">
                            Edit Task
                        </MudButton>
                    }
                </div>

                <div class="flex-grow-1 overflow-y-auto task-scroll-area pr-2">
                    <MudPaper Elevation="0" Class="pa-4 mb-6 rounded-lg"
                              Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-drawer-background);">
                        <MudText Typo="Typo.h6" Class="mb-2"
                                 Style="color: var(--mud-palette-text-primary); font-weight: 600;">Description
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_task.Description))
                        {
                            <MudText Typo="Typo.body1"
                                     Style="white-space: pre-wrap; word-break: break-word; color: var(--mud-palette-text-primary);">@_task.Description</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"
                                     Style="color: var(--mud-palette-text-secondary); font-style: italic;">No
                                description
                                provided.
                            </MudText>
                        }
                    </MudPaper>

                    <TaskAttachment BoardId="BoardId" TaskId="TaskId" Attachments="_task.Attachments"
                                    IsReadOnly="IsArchived"/>

                    <MudDivider Class="my-8"/>

                    <TaskComments BoardId="BoardId" TaskId="TaskId" IsReadOnly="IsArchived"/>
                </div>
            </div>

            <div class="flex-shrink-0" style="width: 100%; max-width: 320px; overflow-y: auto;">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg"
                          Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-drawer-background);">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4" Style="color: var(--mud-palette-text-primary);">
                        Task Details
                    </MudText>

                    <div class="d-flex flex-column gap-4">
                        <div>
                            <MudText Typo="Typo.caption"
                                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase;">
                                Reporter
                            </MudText>
                            <div class="d-flex align-center gap-2 mt-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Style="font-size: 12px;">
                                    @if (!string.IsNullOrEmpty(_task.ReporterAvatarUrl))
                                    {
                                        <MudImage Src="@_task.ReporterAvatarUrl"/>
                                    }
                                    else
                                    {
                                        @((_task.ReporterName?.FirstOrDefault() ?? 'U').ToString().ToUpper())
                                    }
                                </MudAvatar>
                                <MudText Typo="Typo.body2"
                                         Style="color: var(--mud-palette-text-primary); font-weight: 500;">
                                    @(_task.ReporterName ?? "Unknown User")
                                </MudText>
                            </div>
                        </div>

                        <MudDivider/>

                        <div>
                            <MudText Typo="Typo.caption"
                                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase;">
                                Assignee
                            </MudText>
                            @if (_task.AssigneeId.HasValue)
                            {
                                <div class="d-flex align-center gap-2 mt-1">
                                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Style="font-size: 12px;">
                                        @if (!string.IsNullOrEmpty(_task.AssigneeAvatarUrl))
                                        {
                                            <MudImage Src="@_task.AssigneeAvatarUrl"/>
                                        }
                                        else
                                        {
                                            @((_task.AssigneeName?.FirstOrDefault() ?? 'U').ToString().ToUpper())
                                        }
                                    </MudAvatar>
                                    <MudText Typo="Typo.body2"
                                             Style="color: var(--mud-palette-text-primary); font-weight: 500;">
                                        @(_task.AssigneeName ?? "Unknown User")
                                    </MudText>
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"
                                         Style="color: var(--mud-palette-text-secondary); font-style: italic;">
                                    Unassigned
                                </MudText>
                            }
                        </div>

                        <MudDivider/>

                        <div>
                            <MudText Typo="Typo.caption"
                                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase;">
                                Due Date
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mt-1"
                                     Style="color: var(--mud-palette-text-primary); font-weight: 500;">
                                @(_task.DueDate.HasValue ? _task.DueDate.Value.ToString("MMM dd, yyyy") : "None")
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            </div>

        </div>
    }
</MudContainer>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private TaskDto? _task;
    private bool _isLoading = true;

    private bool IsArchived => BoardDetailsStore.Board?.IsArchived == true;
    private bool CanManageTasks => !IsArchived && BoardDetailsStore.Board?.BoardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    protected override async Task OnInitializedAsync()
    {
        if (BoardDetailsStore.Board?.Id != BoardId)
        {
            await BoardDetailsStore.LoadAsync(BoardId);
        }

        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        try
        {
            _isLoading = true;
            _task = await TaskApi.GetTaskByIdAsync(BoardId, TaskId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { x => x.Task, _task },
            { x => x.BoardId, BoardId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            if (result.Data is UpdateTaskRequest request)
            {
                try
                {
                    var updatedTask = await TaskApi.UpdateTaskAsync(BoardId, TaskId, request);
                    var currentAttachments = _task?.Attachments;

                    _task = updatedTask with { Attachments = currentAttachments ?? new List<AttachmentDto>() };
                    Snackbar.Add("Task updated", Severity.Success);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
            }
            else if (result.Data?.ToString() == "DELETE")
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    "Delete Task",
                    "Are you sure you want to delete this task? This action cannot be undone.",
                    yesText: "Delete", cancelText: "Cancel");

                if (confirmed == true)
                {
                    try
                    {
                        await TaskApi.DeleteTaskAsync(BoardId, TaskId);
                        Snackbar.Add("Task deleted", Severity.Success);
                        Navigation.NavigateTo($"/boards/{BoardId}");
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Failed to delete task: {ex.Message}", Severity.Error);
                    }
                }
            }
        }
    }

}