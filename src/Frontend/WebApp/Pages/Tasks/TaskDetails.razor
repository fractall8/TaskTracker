@page "/boards/{BoardId:guid}/tasks/{TaskId:guid}"
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Tasks
@using Services.Abstractions.Tasks
@using WebApp.Components.TaskAttachment
@using WebApp.Components.TaskComments
@using WebApp.Shared.Dialogs
@inject ITaskApiService TaskApi
@inject IBoardDetailsStore BoardDetailsStore
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<main class="main task-main">
    <button class="crumb crumb-btn" @onclick="@(() => Navigation.NavigateTo($"/boards/{BoardId}"))">
        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
        Back to board
    </button>

    @if (_isLoading || (BoardDetailsStore.IsLoading && BoardDetailsStore.Board == null))
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (_task != null)
    {
        @if (IsArchived)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-6 rounded-lg"
                      Icon="@Icons.Material.Filled.Archive"
                      Style="border-width: 2px; background-color: var(--mud-palette-surface);">
                This board is archived. The task and its details are in Read-Only mode.
            </MudAlert>
        }

        <div class="task-detail-grid">
            <div class="task-detail-main">
                <div class="task-detail-head">
                    <h1>@_task.Title</h1>
                    @if (CanManageTasks)
                    {
                        <button class="icon-btn sm ghost" aria-label="Edit task info" @onclick="OpenEditTaskDialog">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                        </button>
                    }
                </div>

                <section class="task-section">
                    <p class="task-section-title">Description</p>
                    @if (!string.IsNullOrWhiteSpace(_task.Description))
                    {
                        <p class="task-desc-full">@_task.Description</p>
                    }
                    else
                    {
                        <p class="task-desc-placeholder">No description yet. Click the edit icon to add one.</p>
                    }
                </section>

                <div class="task-section mt-8">
                    <TaskAttachment BoardId="BoardId" TaskId="TaskId" Attachments="_task.Attachments"
                                    IsReadOnly="IsArchived"/>
                </div>

                <div class="task-section mt-8">
                    <TaskComments BoardId="BoardId" TaskId="TaskId" IsReadOnly="IsArchived"/>
                </div>
            </div>

            <aside class="task-detail-side">
                <div class="side-meta-row">
                    <p class="info-label">Created by</p>
                    <div class="cell-member">
                        <div class="avatar-round @GetColorClass(_task.ReporterName)">
                            @if (!string.IsNullOrEmpty(_task.ReporterAvatarUrl))
                            {
                                <img src="@_task.ReporterAvatarUrl" alt="Avatar"
                                     style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                            }
                            else
                            {
                                @GetInitials(_task.ReporterName)
                            }
                        </div>
                        <span class="info-value" style="font-size: 13px">@(_task.ReporterName ?? "Unknown User")</span>
                    </div>
                </div>

                <div class="side-meta-row mt-2">
                    <p class="info-label">Assignee</p>
                    <button class="fake-select" style="width: 100%; justify-content: space-between;"
                            @onclick="OpenEditTaskDialog" disabled="@(!CanManageTasks)">
                        <span style="display: flex; align-items: center; gap: 8px;">
                            @if (_task.AssigneeId.HasValue)
                            {
                                <span class="avatar-round tiny @GetColorClass(_task.AssigneeName)">
                                    @if (!string.IsNullOrEmpty(_task.AssigneeAvatarUrl))
                                    {
                                        <img src="@_task.AssigneeAvatarUrl" alt="Avatar"
                                             style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                                    }
                                    else
                                    {
                                        @GetInitials(_task.AssigneeName)
                                    }
                                </span>
                                @(_task.AssigneeName ?? "Unknown User")
                            }
                            else
                            {
                                <span>Unassigned</span>
                            }
                        </span>
                        @if (CanManageTasks)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"/>
                        }
                    </button>
                </div>

                <div class="side-meta-row mt-2">
                    <p class="info-label">Due date</p>
                    <button class="fake-select" style="width: 100%; justify-content: space-between;"
                            @onclick="OpenEditTaskDialog" disabled="@(!CanManageTasks)">
                        <span style="display: flex; align-items: center; gap: 8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small"/>
                            @{ var due = GetDueInfo(_task.DueDate); }
                            <span class="due-text due-@due.tone">@due.text</span>
                        </span>
                        @if (CanManageTasks)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"/>
                        }
                    </button>
                </div>
            </aside>
        </div>
    }
</main>

@code {
    [Parameter] public Guid BoardId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private TaskDto? _task;
    private bool _isLoading = true;

    private bool IsArchived => BoardDetailsStore.Board?.IsArchived == true;
    private bool CanManageTasks => !IsArchived && BoardDetailsStore.Board?.BoardRole is BoardRoleDto.Admin or BoardRoleDto.ScrumMaster;

    private string GetColorClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "bg-purple";
        var colors = new[] { "bg-purple", "bg-blue", "bg-teal", "bg-coral", "bg-pink" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[1][..1]).ToUpper();
    }

    private (string text, string tone) GetDueInfo(DateTimeOffset? dueDate)
    {
        if (!dueDate.HasValue) return ("No due date", "muted");
        var today = DateTimeOffset.UtcNow.Date;
        var due = dueDate.Value.Date;
        var diff = (int)(due - today).TotalDays;

        if (diff < 0) return ($"Overdue by {-diff} day{(-diff == 1 ? "" : "s")}", "danger");
        if (diff == 0) return ("Due today", "danger");
        if (diff <= 2) return (diff == 1 ? "Due tomorrow" : $"Due in {diff} days", "danger");
        return ($"Due in {diff} days", "green");
    }

    protected override async Task OnInitializedAsync()
    {
        if (BoardDetailsStore.Board?.Id != BoardId)
        {
            await BoardDetailsStore.LoadAsync(BoardId);
        }

        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        try
        {
            _isLoading = true;
            _task = await TaskApi.GetTaskByIdAsync(BoardId, TaskId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load task: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { x => x.Task, _task },
            { x => x.BoardId, BoardId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            if (result.Data is UpdateTaskRequest request)
            {
                try
                {
                    var updatedTask = await TaskApi.UpdateTaskAsync(BoardId, TaskId, request);
                    var currentAttachments = _task?.Attachments;

                    _task = updatedTask with { Attachments = currentAttachments ?? new List<AttachmentDto>() };
                    Snackbar.Add("Task updated", Severity.Success);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
            }
            else if (result.Data?.ToString() == "DELETE")
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    "Delete Task",
                    "Are you sure you want to delete this task? This action cannot be undone.",
                    yesText: "Delete", cancelText: "Cancel");

                if (confirmed == true)
                {
                    try
                    {
                        await TaskApi.DeleteTaskAsync(BoardId, TaskId);
                        Snackbar.Add("Task deleted", Severity.Success);
                        Navigation.NavigateTo($"/boards/{BoardId}");
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Failed to delete task: {ex.Message}", Severity.Error);
                    }
                }
            }
        }
    }

}