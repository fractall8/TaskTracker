@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject IWorkspaceStore WorkspaceStore
@inject IDialogService DialogService
@inject CustomToastService Toast
@inject NavigationManager Navigation
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Workspaces
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Helpers
@using WebApp.Shared.Toast

<PageTitle>Workspaces - TaskTracker</PageTitle>

<div class="dashboard-container">
    <header class="content-header">
        <div class="header-titles">
            <h1>Workspaces</h1>
            <p class="subtitle">
                @(WorkspaceStore.Workspaces?.Count ?? 0) workspace@(WorkspaceStore.Workspaces?.Count == 1 ? "" : "s")
            </p>
        </div>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog"
                   Class="rounded-lg px-6 py-2"
                   Style="font-weight: 600; text-transform: none; font-size: 15px;">
            Create workspace
        </MudButton>
    </header>

    @if (WorkspaceStore.IsLoading)
    {
        <div class="d-flex justify-center mt-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (!string.IsNullOrEmpty(WorkspaceStore.ErrorMessage))
    {
        <div class="custom-alert error mt-4">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Class="custom-alert-icon"/>
            <div class="custom-alert-content">
                <p>@WorkspaceStore.ErrorMessage</p>
            </div>
        </div>
    }
    else if (!WorkspaceStore.Workspaces.Any())
    {
        <div class="workspaces-grid">
            <div class="ws-card new-card" @onclick="OpenCreateDialog">
                <div class="new-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size: 32px;" Class="mb-2"/>
                    <p style="font-size: 16px; font-weight: 500;">New workspace</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="workspaces-grid">
            @foreach (var workspace in WorkspaceStore.Workspaces)
            {
                <div class="ws-card" @onclick="@(() => Navigation.NavigateTo($"/workspaces/{workspace.Id}"))">
                    <div class="ws-card-header">
                        <div class="ws-avatar @AvatarColorHelper.GetColorClass(workspace.Name)">
                            @(workspace.Name.FirstOrDefault().ToString().ToUpper())
                        </div>
                        <div class="ws-card-actions" @onclick:stopPropagation="true">
                            @if (workspace.UserRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Medium" Dense="true"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                 OnClick="@(() => OpenEditDialog(workspace))">Edit
                                    </MudMenuItem>
                                    @if (workspace.UserRole is WorkspaceRoleDto.Owner)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                                     OnClick="@(() => DeleteWorkspace(workspace))">Delete
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            }
                        </div>
                    </div>

                    <div class="ws-card-body">
                        <h3>@workspace.Name</h3>
                        <p>@(string.IsNullOrWhiteSpace(workspace.Description) ? "No description provided." : workspace.Description)</p>
                    </div>

                    <div class="ws-card-footer">
                        @if (workspace.UserRole == WorkspaceRoleDto.Owner)
                        {
                            <span class="ws-badge ws-badge-owner">Owner</span>
                        }
                        else if (workspace.UserRole == WorkspaceRoleDto.Admin)
                        {
                            <span class="ws-badge ws-badge-admin">Admin</span>
                        }
                        else
                        {
                            <span class="ws-badge ws-badge-participant">Participant</span>
                        }
                    </div>
                </div>
            }

            <div class="ws-card new-card" @onclick="OpenCreateDialog">
                <div class="new-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size: 32px;" Class="mb-2"/>
                    <p style="font-size: 16px; font-weight: 500;">New<br/>workspace</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    
    protected override void OnInitialized() =>
        WorkspaceStore.StateChanged += OnStoreStateChanged;

    protected override async Task OnInitializedAsync() =>
        await WorkspaceStore.LoadUserWorkspacesAsync();

    public void Dispose() =>
        WorkspaceStore.StateChanged -= OnStoreStateChanged;

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WorkspaceDialog>("Create Workspace", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CreateWorkspaceRequest request })
        {
            try
            {
                await WorkspaceStore.CreateWorkspaceAsync(request);
                Toast.ShowSuccess("Workspace created successfully.");
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to create workspace: {ex.Message}");
            }
        }
    }

    private async Task OpenEditDialog(WorkspaceDto workspace)
    {
        var parameters = new DialogParameters<WorkspaceDialog> { { x => x.Workspace, workspace } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WorkspaceDialog>("Edit Workspace", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CreateWorkspaceRequest request })
        {
            try
            {
                await WorkspaceStore.UpdateWorkspaceAsync(workspace.Id, new UpdateWorkspaceRequest(request.Name, request.Description));
                Toast.ShowSuccess("Workspace updated successfully.");
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to update workspace: {ex.Message}");
            }
        }
    }

    private async Task DeleteWorkspace(WorkspaceDto workspace)
    {
        var safeName = workspace.Name.Length > 40 ? workspace.Name[..40] + "..." : workspace.Name;

        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Delete workspace" },
            { x => x.ContentText, $"Are you sure you want to delete \"{safeName}\"? All of its boards, columns and tasks will be permanently removed." },
            { x => x.ConfirmText, "Delete workspace" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await WorkspaceStore.DeleteWorkspaceAsync(workspace.Id);
                Toast.ShowSuccess("Workspace deleted.");
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to delete workspace: {ex.Message}");
            }
        }
    }

}