@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject IProfileStore ProfileStore
@inject NavigationManager Navigation

<PageTitle>Dashboard - TaskTracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (ProfileStore.IsLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (ProfileStore.IsLoaded && ProfileStore.Profile is { } profile)
    {
        <MudGrid>
            <MudItem xs="12" sm="8" md="6" lg="5">
                <MudPaper Elevation="2" Class="pa-6 rounded-lg">
                    
                    <div class="d-flex align-center mb-6">
                        <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mr-4 elevation-1 font-weight-bold">
                            @(profile.DisplayName?.FirstOrDefault() ?? profile.Email?.FirstOrDefault() ?? '?')
                        </MudAvatar>
                        
                        <div>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                Welcome, @(profile.DisplayName ?? "User")
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @profile.Email
                            </MudText>
                        </div>
                    </div>
                    
                    <MudDivider Class="mb-4" />
                    
                    <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-bold" Color="Color.Secondary">
                        ACCOUNT ROLES
                    </MudText>
                    
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        @if (profile.Roles.Any())
                        {
                            @foreach (var role in profile.Roles)
                            {
                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Class="font-weight-medium">
                                    @role
                                </MudChip>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No roles assigned.</MudText>
                        }
                    </MudStack>

                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else if (ProfileStore.ErrorMessage is { } error)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">
            @error
        </MudAlert>
    }
</MudContainer>

@code {
    protected override void OnInitialized() =>
        ProfileStore.StateChanged += OnStoreStateChanged;

    protected override async Task OnInitializedAsync()
    {
        await ProfileStore.EnsureLoadedAsync();

        if (ProfileStore.RequiresLogin)
            Navigation.NavigateTo("/login");
    }

    public void Dispose() => ProfileStore.StateChanged -= OnStoreStateChanged;

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);
}