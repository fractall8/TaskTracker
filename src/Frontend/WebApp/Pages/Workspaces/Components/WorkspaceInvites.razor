@inject IWorkspaceStore WorkspaceStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject NavigationManager Navigation
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Workspaces
@using WebApp.Shared.Dialogs

<div class="toolbar" style="justify-content: flex-end;">
    <button class="btn ghost" aria-label="Refresh invites" @onclick="LoadInvitesAsync" disabled="@_loading">
        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
        Refresh
    </button>
    <button class="btn btn-primary" @onclick="GenerateInviteLink" disabled="@_loading">
        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
        Create invite
    </button>
</div>

@if (_loading && !_invites.Any())
{
    <div class="d-flex justify-center mt-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>
}
else
{
    <table class="data-table">
        <thead>
        <tr>
            <th>Token</th>
            <th>Status</th>
            <th>Created</th>
            <th>Expires</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var invite in _invites)
        {
            <tr>
                <td>
                    <div class="cell-token">
                        <code class="token @(_visibleTokens.Contains(invite.Id) ? "revealed" : "")">
                            @(_visibleTokens.Contains(invite.Id) ? invite.Token : "••••••••••" + (invite.Token.Length >= 4 ? invite.Token.Substring(invite.Token.Length - 4) : ""))
                        </code>
                        <button class="icon-btn sm ghost" aria-label="Reveal token"
                                @onclick="@(() => ToggleTokenVisibility(invite.Id))">
                            <MudIcon
                                Icon="@(_visibleTokens.Contains(invite.Id) ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                Size="Size.Small"/>
                        </button>
                        <button class="icon-btn sm ghost" aria-label="Copy link"
                                @onclick="@(() => CopyToClipboardAsync(GetInviteUrl(invite.Token)))">
                            <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"/>
                        </button>
                    </div>
                </td>
                <td>
                    @if (invite.ExpiresAt < DateTimeOffset.UtcNow)
                    {
                        <span class="badge badge-gray">Expired</span>
                    }
                    else
                    {
                        <span class="badge badge-green">Active</span>
                    }
                </td>
                <td class="muted">@invite.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td class="muted">@invite.ExpiresAt.ToLocalTime().ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td class="actions">
                    <button class="icon-btn sm ghost" aria-label="Edit invite"
                            @onclick="@(() => OpenEditInviteDialog(invite))">
                        <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                    </button>
                    <button class="icon-btn sm ghost" aria-label="Delete invite"
                            @onclick="@(() => RevokeInvite(invite.Id))">
                        <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"/>
                    </button>
                </td>
            </tr>
        }
        @if (!_invites.Any())
        {
            <tr>
                <td colspan="5" style="text-align: center;" class="muted">No active or expired invites found.</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    [Parameter] public WorkspaceRoleDto? CurrentUserRole { get; set; }

    private IReadOnlyList<WorkspaceInviteDto> _invites = [];
    private bool _loading;
    private readonly HashSet<Guid> _visibleTokens = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadInvitesAsync();
    }

    private async Task LoadInvitesAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _invites = await WorkspaceStore.GetWorkspaceInvitesAsync(WorkspaceId);
            _visibleTokens.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load invites: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateInviteLink()
    {
        try
        {
            var request = new InviteUserRequest(string.Empty);
            var result = await WorkspaceStore.InviteUserAsync(WorkspaceId, request);
            if (result != null)
            {
                Snackbar.Add("Invite link generated.", Severity.Success);
                await LoadInvitesAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleTokenVisibility(Guid inviteId)
    {
        if (!_visibleTokens.Add(inviteId)) _visibleTokens.Remove(inviteId);
    }

    private async Task OpenEditInviteDialog(WorkspaceInviteDto invite)
    {
        var parameters = new DialogParameters<EditInviteDialog> { { x => x.CurrentExpiration, invite.ExpiresAt } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditInviteDialog>("Edit Expiration", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: UpdateInviteExpirationRequest request })
        {
            try
            {
                await WorkspaceStore.UpdateInviteExpirationAsync(WorkspaceId, invite.Id, request);
                Snackbar.Add("Expiration date updated.", Severity.Success);
                await LoadInvitesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task RevokeInvite(Guid inviteId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Revoke Invite", "Revoke this invite?", yesText: "Revoke", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                await WorkspaceStore.RevokeInviteAsync(WorkspaceId, inviteId);
                Snackbar.Add("Invite revoked.", Severity.Success);
                await LoadInvitesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to revoke: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetInviteUrl(string token) => $"{Navigation.BaseUri.TrimEnd('/')}/accept-invite?token={token}";

    private async Task CopyToClipboardAsync(string text)
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add("Link copied.", Severity.Info);
    }

}