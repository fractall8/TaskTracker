@inject IWorkspaceStore WorkspaceStore
@inject IBoardApiService BoardApiService
@inject IDialogService DialogService
@inject CustomToastService Toast
@inject NavigationManager Navigation
@using Contracts.DTOs
@using Contracts.Enums
@using Contracts.Requests.Boards
@using WebApp.Shared.Dialogs
@using WebApp.Shared.Toast

<div class="toolbar">
    <div class="search-input">
        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small"/>
        <input placeholder="Search boards" value="@_searchTerm" @oninput="OnSearchInput"/>
    </div>
    <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
        <div class="pg-size">
            <span>Items per page</span>
            <select value="@_pageSize" @onchange="OnPageSizeChangedNative">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="48">48</option>
            </select>
        </div>
        @if (CurrentUserRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner)
        {
            <button class="btn btn-primary" @onclick="OpenCreateBoardDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/>
                Create board
            </button>
        }
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center mt-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </div>
}
else if (!_boards.Any())
{
    <div class="empty-state mt-4">
        <MudIcon Icon="@Icons.Material.Outlined.Dashboard"/>
        <p>@(string.IsNullOrEmpty(_searchTerm) ? "You are not a member of any boards yet." : "No boards match your search.")</p>
    </div>
}
else
{
    <div class="grid">
        @foreach (var board in _boards)
        {
            <div class="card" @onclick="@(() => Navigation.NavigateTo($"/boards/{board.Id}"))" style="cursor: pointer;">
                <div class="card-top">
                    <div class="card-icon @GetColorClass(board.Name)">
                        @(board.Name.FirstOrDefault().ToString().ToUpper())
                    </div>
                    <div class="card-actions" @onclick:stopPropagation="true">
                        @if (CurrentUserRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner || board.BoardRole == BoardRoleDto.Admin)
                        {
                            <button class="icon-btn sm ghost" aria-label="Edit board"
                                    @onclick="@(() => OpenEditBoardDialog(board))">
                                <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                            </button>
                            <button class="icon-btn sm ghost" aria-label="Delete board"
                                    @onclick="@(() => DeleteBoard(board))">
                                <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"/>
                            </button>
                        }
                        @if (Workspace.UserRole == WorkspaceRoleDto.Admin)
                        {
                            <button class="icon-btn sm ghost" aria-label="Leave board"
                                    @onclick="@(() => LeaveBoard(board))">
                                <MudIcon Icon="@Icons.Material.Outlined.ExitToApp" Size="Size.Small"/>
                            </button>
                        }
                    </div>
                </div>
                <p class="card-title">@board.Name</p>
                <p class="card-desc">@(string.IsNullOrWhiteSpace(board.Description) ? "No description provided." : board.Description)</p>
                <div class="card-foot">
                    <span class="badge badge-gray">@board.BoardRole.ToString()</span>
                    <button class="card-open" @onclick="@(() => Navigation.NavigateTo($"/boards/{board.Id}"))">
                        Open board
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"/>
                    </button>
                </div>
            </div>
        }

        @if (CurrentUserRole is WorkspaceRoleDto.Admin or WorkspaceRoleDto.Owner && _currentPage >= _pagination.TotalPages)
        {
            <div class="card-add" @onclick="OpenCreateBoardDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size: 24px;"/>
                <span>New board</span>
            </div>
        }
    </div>

    @if (_pagination.TotalPages > 1)
    {
        <div class="pagination-custom">
            <div class="pg-info">
                @((_currentPage - 1) * _pageSize + 1)&ndash;@(Math.Min(_currentPage * _pageSize, _pagination.TotalCount)) of @_pagination.TotalCount
            </div>
            <div class="pg-controls">
                <button class="icon-btn" disabled="@(!_pagination.HasPrevious)"
                        @onclick="@(() => OnPageChanged(_currentPage - 1))">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
                </button>
                <span>Page @_currentPage of @Math.Max(1, _pagination.TotalPages)</span>
                <button class="icon-btn" disabled="@(!_pagination.HasNext)"
                        @onclick="@(() => OnPageChanged(_currentPage + 1))">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"/>
                </button>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    [Parameter] public WorkspaceDetailsDto Workspace { get; set; } = null!;
    [Parameter] public WorkspaceRoleDto? CurrentUserRole { get; set; }

    private IReadOnlyList<BoardPreviewDto> _boards = [];
    private PaginationMetadata _pagination = new();
    private bool _loading;
    private int _currentPage = 1;
    private int _pageSize = 24;
    private string? _searchTerm;
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _debounceCts;

    private string GetColorClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "bg-purple";
        var colors = new[] { "bg-purple", "bg-blue", "bg-teal", "bg-coral", "bg-pink" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardsAsync();
    }

    private async Task LoadBoardsAsync(CancellationToken ct = default)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var paged = await WorkspaceStore.GetMyWorkspaceBoardsAsync(WorkspaceId, _currentPage, _pageSize, _searchTerm, ct);
            _boards = paged.Items;
            _pagination = paged.Metadata;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load boards: {ex.Message}");
            _boards = [];
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString();

        if (_debounceCts != null)
        {
            await _debounceCts.CancelAsync();
            _debounceCts.Dispose();
        }

        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(500, token); // using 500 ms for default

            if (!token.IsCancellationRequested)
            {
                _currentPage = 1;
                if (_searchCts != null)
                {
                    await _searchCts.CancelAsync();
                    _searchCts.Dispose();
                }

                _searchCts = new CancellationTokenSource();
                await LoadBoardsAsync(_searchCts.Token);
            }
        }
        catch (TaskCanceledException)
        {
            // skip
        }
    }

    private async Task OnPageSizeChangedNative(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = size;
            _currentPage = 1;
            await LoadBoardsAsync();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadBoardsAsync();
    }

    private async Task OpenCreateBoardDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BoardDialog>("Create Board", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CreateBoardRequest request })
        {
            try
            {
                await BoardApiService.CreateBoardAsync(WorkspaceId, request);
                Toast.ShowSuccess("Board created.");
                await LoadBoardsAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to create board: {ex.Message}");
            }
        }
    }

    private async Task OpenEditBoardDialog(BoardPreviewDto board)
    {
        var parameters = new DialogParameters<BoardDialog> { { x => x.Board, board } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BoardDialog>("Edit Board", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: UpdateBoardRequest request })
        {
            try
            {
                await BoardApiService.UpdateBoardAsync(board.Id, request);
                Toast.ShowSuccess("Board updated.");
                await LoadBoardsAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to update board: {ex.Message}");
            }
        }
    }

    private async Task DeleteBoard(BoardPreviewDto board)
    {
        var safeBoardName = board.Name.Length > 40 ? board.Name[..40] + "..." : board.Name;

        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Delete board" },
            { x => x.ContentText, $"Delete \"{safeBoardName}\"? All of its lists and cards will be permanently removed." },
            { x => x.ConfirmText, "Delete board" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await BoardApiService.DeleteBoardAsync(board.Id);
                Toast.ShowSuccess("Board deleted.");
                await LoadBoardsAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to delete board: {ex.Message}");
            }
        }
    }

    private async Task LeaveBoard(BoardPreviewDto board)
    {
        var safeBoardName = board.Name.Length > 40 ? board.Name[..40] + "..." : board.Name;

        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Leave board" },
            { x => x.ContentText, $"Are you sure you want to leave \"{safeBoardName}\"? You will lose access to this board." },
            { x => x.ConfirmText, "Leave board" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await BoardApiService.LeaveBoardAsync(board.Id);
                Toast.ShowSuccess("Left board successfully.");
                await LoadBoardsAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Failed to leave board: {ex.Message}");
            }
        }
    }

}