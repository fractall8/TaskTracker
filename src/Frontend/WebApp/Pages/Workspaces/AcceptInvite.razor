@page "/accept-invite"
@attribute [Authorize]
@inject IWorkspaceStore WorkspaceStore
@inject NavigationManager Navigation

<PageTitle>Accept Invite - TaskTracker</PageTitle>

<div class="invite-container">
    <div class="invite-card">
        @if (_loading)
        {
            <div class="d-flex justify-center mb-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
            </div>
            <h2 class="invite-title">Accepting invite...</h2>
            <p class="invite-desc">Please wait while we add you to the workspace.</p>
        }
        else if (_success)
        {
            <div class="icon-wrapper success-icon">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size: 32px;"/>
            </div>
            <h2 class="invite-title">You're in!</h2>
            <p class="invite-desc">You have successfully joined the workspace and can now access its boards.</p>

            <button class="btn btn-primary" style="width: 100%; height: 44px; margin-top: 8px;"
                    @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
                Go to Dashboard
            </button>
        }
        else if (_error is not null)
        {
            <div class="icon-wrapper error-icon">
                <MudIcon Icon="@Icons.Material.Outlined.GppBad" Style="font-size: 32px;"/>
            </div>
            <h2 class="invite-title">Invite Failed</h2>

            <div class="d-flex align-center justify-center gap-2" style="margin-bottom: 24px;">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Style="color: var(--mud-palette-error);" />
                <span style="font-size: 14.5px; color: var(--mud-palette-text-secondary); line-height: 1;">@_error</span>
            </div>

            <button class="btn" style="width: 100%; height: 44px;"
                    @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
                Back to Dashboard
            </button>
        }
    </div>
</div>

<style>
    .invite-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px);
        padding: 24px;
    }

    .invite-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        padding: 40px 32px;
        max-width: 420px;
        width: 100%;
        text-align: center;
        animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        margin: 0 auto 20px auto;
    }

    .success-icon {
        background-color: rgba(39, 174, 96, 0.12);
        color: var(--mud-palette-success);
    }

    .error-icon {
        background-color: rgba(235, 87, 87, 0.12);
        color: var(--mud-palette-error);
    }

    .invite-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: var(--mud-palette-text-primary);
    }

    .invite-desc {
        font-size: 14.5px;
        color: var(--mud-palette-text-secondary);
        line-height: 1.5;
        margin: 0 0 24px 0;
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool _loading = true;
    private bool _success;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        try
        {
            await WorkspaceStore.AcceptInviteAsync(Token);
            _success = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

}