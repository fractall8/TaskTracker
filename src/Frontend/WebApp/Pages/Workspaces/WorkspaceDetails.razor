@page "/workspaces/{WorkspaceId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject IWorkspaceStore WorkspaceStore
@inject NavigationManager Navigation
@inject IProfileStore ProfileStore
@using Contracts.Enums
@using WebApp.Pages.Workspaces.Components

<PageTitle>@(WorkspaceStore.CurrentWorkspace?.Name ?? "Workspace") - TaskTracker</PageTitle>

@if (WorkspaceStore.IsLoading && WorkspaceStore.CurrentWorkspace == null)
{
    <div class="d-flex justify-center align-center" style="height: 60vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
}
else if (!string.IsNullOrEmpty(WorkspaceStore.ErrorMessage))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">
            @GetSafeErrorMessage(WorkspaceStore.ErrorMessage)
        </MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4 fw-bold"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/dashboard"))">
            Return to Dashboard
        </MudButton>
    </MudContainer>
}
else if (WorkspaceStore.CurrentWorkspace is { } workspace)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-8 px-4">
        <div class="d-flex align-center mb-4 gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Navigation.NavigateTo("/dashboard"))"/>
            <MudText Typo="Typo.h4" Class="fw-bold" Style="color: var(--mud-palette-text-primary);">
                @workspace.Name
            </MudText>
        </div>

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">

            <MudTabPanel Text="Boards" Icon="@Icons.Material.Filled.Dashboard">
                <WorkspaceActiveBoards WorkspaceId="WorkspaceId" Workspace="workspace"
                                       CurrentUserRole="_currentUserRole"/>
            </MudTabPanel>

            <MudTabPanel Text="Archived" Icon="@Icons.Material.Filled.Archive">
                <WorkspaceArchivedBoards WorkspaceId="WorkspaceId"/>
            </MudTabPanel>

            <MudTabPanel Text="Members" Icon="@Icons.Material.Filled.Group">
                <WorkspaceMembers WorkspaceId="WorkspaceId" Workspace="workspace" CurrentUserRole="_currentUserRole"
                                  CurrentUserId="_currentUserId"/>
            </MudTabPanel>

            @if (_currentUserRole is WorkspaceRoleDto.Owner)
            {
                <MudTabPanel Text="Invites" Icon="@Icons.Material.Filled.VpnKey">
                    <WorkspaceInvites WorkspaceId="WorkspaceId" CurrentUserRole="_currentUserRole"/>
                </MudTabPanel>
            }

        </MudTabs>
    </MudContainer>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    private WorkspaceRoleDto? _currentUserRole;
    private Guid? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceStore.StateChanged += OnStoreStateChanged;
        await ProfileStore.EnsureLoadedAsync();
        _currentUserId = ProfileStore.Profile?.Id;

        await WorkspaceStore.LoadWorkspaceDetailsAsync(WorkspaceId);
        ResolveCurrentUserRole();
    }

    public void Dispose()
    {
        WorkspaceStore.StateChanged -= OnStoreStateChanged;
    }

    private void OnStoreStateChanged()
    {
        ResolveCurrentUserRole();
        InvokeAsync(StateHasChanged);
    }

    private void ResolveCurrentUserRole()
    {
        if (_currentUserId.HasValue && WorkspaceStore.CurrentWorkspace is { } ws)
        {
            _currentUserRole = ws.Members
                .FirstOrDefault(m => m.UserId == _currentUserId.Value)?.Role;
        }
    }

    private string GetSafeErrorMessage(string error)
    {
        var lowerError = error.ToLowerInvariant();
        if (lowerError.Contains("member") || lowerError.Contains("found") || lowerError.Contains("forbidden") || lowerError.Contains("access"))
        {
            return "Workspace not found or you don't have permission to view it.";
        }

        return error;
    }

}