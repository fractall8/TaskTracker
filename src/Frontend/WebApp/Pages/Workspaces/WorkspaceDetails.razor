@page "/workspaces/{WorkspaceId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject IWorkspaceStore WorkspaceStore
@inject IWorkspaceSubscriptionsStore SubscriptionsStore
@inject NavigationManager Navigation
@inject IProfileStore ProfileStore
@using Contracts.Enums
@using Services.Abstractions.Subscriptions.Stores
@using WebApp.Pages.Workspaces.Components
@using WebApp.Shared.Helpers

<PageTitle>@(WorkspaceStore.CurrentWorkspace?.Name ?? "Workspace") - TaskTracker</PageTitle>

@if (WorkspaceStore.IsLoading && WorkspaceStore.CurrentWorkspace == null)
{
    <div class="d-flex justify-center align-center" style="height: 60vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    </div>
}
else if (!string.IsNullOrEmpty(WorkspaceStore.ErrorMessage))
{
    <div class="workspace-details @(IsDarkMode ? "dark" : "")" @key="WorkspaceId">
        <div class="custom-alert error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Class="custom-alert-icon"/>
            <div class="custom-alert-content">
                <p>@GetSafeErrorMessage(WorkspaceStore.ErrorMessage)</p>
            </div>
        </div>
        <button class="crumb mt-4" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
            Return to Dashboard
        </button>
    </div>
}
else if (WorkspaceStore.CurrentWorkspace is { } workspace)
{
    <div class="workspace-details @(IsDarkMode ? "dark" : "")" @key="WorkspaceId">
        <button class="crumb" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"/>
            All workspaces
        </button>

        <div class="ws-header">
            <div class="ws-icon @AvatarColorHelper.GetColorClass(workspace.Name)">
                @(workspace.Name.FirstOrDefault().ToString().ToUpper())
            </div>
            <div class="ws-info">
                <div class="ws-title-row">
                    <h1>@workspace.Name</h1>
                    <span class="badge badge-purple">@_currentUserRole.ToString()</span>
                    @if (SubscriptionsStore.Entitlements is { } entitlements)
                    {
                        <span class="badge @PlanBadgeColorClass(entitlements.PlanId)">@entitlements.PlanDisplayName Plan</span>
                    }
                </div>
                <p>@(string.IsNullOrWhiteSpace(workspace.Description) ? "No description provided." : workspace.Description)</p>
            </div>
        </div>

        <nav class="tabs">
            <button class="tab @(_activeTab == "boards" ? "active" : "")" @onclick="@(() => _activeTab = "boards")">
                Boards
            </button>
            <button class="tab @(_activeTab == "archived" ? "active" : "")" @onclick="@(() => _activeTab = "archived")">
                Archived
            </button>
            <button class="tab @(_activeTab == "members" ? "active" : "")" @onclick="@(() => _activeTab = "members")">
                Members
            </button>
            <button class="tab @(_activeTab == "tags" ? "active" : "")" @onclick="@(() => _activeTab = "tags")">
                Tags
            </button>
            @if (_currentUserRole is WorkspaceRoleDto.Owner)
            {
                <button class="tab @(_activeTab == "invites" ? "active" : "")"
                        @onclick="@(() => _activeTab = "invites")">
                    Invites
                </button>
                <button class="tab @(_activeTab == "subscription" ? "active" : "")"
                        @onclick="@(() => _activeTab = "subscription")">
                    Subscriptions
                </button>
            }
        </nav>

        <div class="tab-content">
            @if (_activeTab == "boards")
            {
                <WorkspaceActiveBoards WorkspaceId="WorkspaceId" Workspace="workspace"
                                       CurrentUserRole="_currentUserRole"/>
            }
            else if (_activeTab == "archived")
            {
                <WorkspaceArchivedBoards WorkspaceId="WorkspaceId"/>
            }
            else if (_activeTab == "members")
            {
                <WorkspaceMembers WorkspaceId="WorkspaceId"
                                  Workspace="workspace"
                                  CurrentUserRole="_currentUserRole"
                                  CurrentUserId="_currentUserId"
                                  OnRefreshRequested="HandleMembersRefresh"/>
            }
            else if (_activeTab == "tags")
            {
                <WorkspaceTags WorkspaceId="WorkspaceId" CurrentUserRole="_currentUserRole"/>
            }
            else if (_activeTab == "invites" && _currentUserRole is WorkspaceRoleDto.Owner)
            {
                <WorkspaceInvites WorkspaceId="WorkspaceId" CurrentUserRole="_currentUserRole"/>
            }
            else if (_activeTab == "subscription" && _currentUserRole is WorkspaceRoleDto.Owner)
            {
                <WorkspaceSubscription WorkspaceId="WorkspaceId" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [CascadingParameter] public bool IsDarkMode { get; set; }

    private WorkspaceRoleDto? _currentUserRole;
    private Guid? _currentUserId;

    private string _activeTab = "boards";

    protected override async Task OnInitializedAsync()
    {
        WorkspaceStore.StateChanged += OnStoreStateChanged;
        SubscriptionsStore.StateChanged += OnSubscriptionsStateChanged;
        await ProfileStore.EnsureLoadedAsync();
        _currentUserId = ProfileStore.Profile?.Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Task.WhenAll(
            WorkspaceStore.LoadWorkspaceDetailsAsync(WorkspaceId),
            SubscriptionsStore.LoadBillingDataAsync(WorkspaceId));
        ResolveCurrentUserRole();
    }

    public void Dispose()
    {
        WorkspaceStore.StateChanged -= OnStoreStateChanged;
        SubscriptionsStore.StateChanged -= OnSubscriptionsStateChanged;
    }

    private void OnSubscriptionsStateChanged() => InvokeAsync(StateHasChanged);

    private static string PlanBadgeColorClass(string planId) => planId.ToLowerInvariant() switch
    {
        "pro" => "badge-blue",
        "business" => "badge-teal",
        _ => "badge-gray"
    };

    private void OnStoreStateChanged()
    {
        ResolveCurrentUserRole();
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleMembersRefresh()
    {
        await WorkspaceStore.LoadWorkspaceDetailsAsync(WorkspaceId);
    }

    private void ResolveCurrentUserRole()
    {
        if (_currentUserId.HasValue && WorkspaceStore.CurrentWorkspace is { } ws)
        {
            _currentUserRole = ws.Members.FirstOrDefault(m => m.UserId == _currentUserId.Value)?.Role;
        }
    }

    private string GetSafeErrorMessage(string error)
    {
        var lowerError = error.ToLowerInvariant();
        if (lowerError.Contains("member") || lowerError.Contains("found") || lowerError.Contains("forbidden") || lowerError.Contains("access"))
        {
            return "Workspace not found or you don't have permission to view it.";
        }

        return error;
    }

}