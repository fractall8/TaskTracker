{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=DB_NAME;Username=DB_USERNAME;Password=DB_PASSWORD;",
    "AzureBlobStorage": "UseDevelopmentStorage=true;"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "DIRECTORY_TENANT_ID",
    "ClientId": "APPLICATION_CLIENT_ID"
  },
  "FileSettings": {
    "Avatars": {
      "MaxSizeMb": 2,
      "AllowedTypes": [
        "image/jpeg",
        "image/png"
      ]
    },
    "Attachments": {
      "MaxSizeMb": 10,
      "AllowedTypes": [
        "image/jpeg",
        "image/png",
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "text/plain",
        "video/mp4"
      ]
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
