{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=DB_NAME;Username=DB_USERNAME;Password=DB_PASSWORD;",
    "AzureBlobStorage": "UseDevelopmentStorage=true;",
    "ServiceBus": "CONNECTION_FOR_SERVICE_BUS",
    "CosmosDB": "CONNECTION_FOR_COSMOS_DB"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "APPLICATION_CLIENT_ID"
  },
  "FileSettings": {
    "Avatars": {
      "MaxSizeMb": 2,
      "AllowedTypes": [
        "image/jpeg",
        "image/jpg",
        "image/png"
      ]
    },
    "Attachments": {
      "MaxSizeMb": 10,
      "AllowedTypes": [
        "image/jpeg",
        "image/png",
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "text/plain",
        "video/mp4"
      ]
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Pagination": {
    "DefaultPageSize": 24,
    "MaxPageSize": 100,
    "MaxSearchTermLength": 100
  },
  "WorkspaceSettings": {
    "InviteExpiryDays": 7
  },
  "BoardExportScheduler": {
    "CronExpression": "*/15 * * * * *",
    "DocumentBatchSize": 10
  },
  "BoardExportRecoveryScheduler": {
    "CronExpression": "*/5 * * * *",
    "DocumentBatchSize": 10,
    "FailedRetryCooldownMinutes": 5,
    "StaleCooldownMinutes": 120
  },
  "ServiceBus": {
    "QueueNames": {
      "BoardArchivingQueueName": "board-archiving-queue"
    }
  },
  "CosmosDB": {
    "DatabaseName": "TaskTrackerCosmosDB",
    "Containers": {
      "BoardExport": "BoardExports"
    }
  },
  "InternalApi": {
    "ApiKeyHeaderName": "X-Internal-Api-Key",
    "ApiKey": "dev-internal-api-key"
  },
  "AllowedHosts": "*"
}
